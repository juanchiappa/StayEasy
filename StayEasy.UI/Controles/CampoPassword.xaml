<UserControl x:Class="StayEasy.UI.Controles.CampoPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <Border BorderBrush="#CCCCCC" BorderThickness="1" CornerRadius="8" Background="White" Padding="10,6">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid MinHeight="28">
                <PasswordBox x:Name="EntradaOculta" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" />
                <TextBox x:Name="EntradaVisible" Visibility="Collapsed" BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center" />
                <TextBlock x:Name="MarcaAgua" Text="Ingresá tu contraseña" Foreground="#888888" VerticalAlignment="Center" IsHitTestVisible="False" />
            </Grid>
            <ToggleButton x:Name="BotonMostrar" Grid.Column="1" Content="Mostrar" ToolTip="Mostrar contraseña"
                          Margin="8,0,0,0" Padding="8,4" VerticalAlignment="Center" />
        </Grid>
    </Border>
</UserControl>
