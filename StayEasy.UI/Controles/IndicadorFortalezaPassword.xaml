<UserControl x:Class="StayEasy.UI.Controles.IndicadorFortalezaPassword"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel>
        <ProgressBar x:Name="Barra" Minimum="0" Maximum="4" Height="7" Background="#EEEEEE" />
        <TextBlock x:Name="Descripcion" Margin="0,5,0,8" TextWrapping="Wrap" />
        <WrapPanel>
            <TextBlock x:Name="RequisitoLongitud" Margin="0,0,14,5" />
            <TextBlock x:Name="RequisitoMayuscula" Margin="0,0,14,5" />
            <TextBlock x:Name="RequisitoNumero" Margin="0,0,0,5" />
        </WrapPanel>
    </StackPanel>
</UserControl>
