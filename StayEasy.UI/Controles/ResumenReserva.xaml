<UserControl x:Class="StayEasy.UI.Controles.ResumenReserva"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Border Background="#202020" CornerRadius="16" Padding="20">
        <StackPanel>
            <TextBlock Text="Resumen" Foreground="White" FontSize="18" FontWeight="SemiBold" />
            <TextBlock x:Name="Identificador" Foreground="#CCCCCC" Margin="0,5,0,12" />
            <TextBlock x:Name="Habitacion" Foreground="White" TextWrapping="Wrap" />
            <TextBlock x:Name="Noches" Foreground="#CCCCCC" Margin="0,4,0,12" />
            <TextBlock x:Name="Alojamiento" Foreground="White" Margin="0,0,0,6" />
            <TextBlock x:Name="Servicios" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Separator />
            <TextBlock x:Name="Total" Foreground="White" FontSize="24" FontWeight="SemiBold" Margin="0,12,0,12" />
            <TextBlock x:Name="Senia" Foreground="#CCCCCC" Margin="0,0,0,6" />
            <TextBlock x:Name="Saldo" Foreground="White" />
            <TextBlock x:Name="Estado" Foreground="#CCCCCC" TextWrapping="Wrap" Margin="0,14,0,0" />
        </StackPanel>
    </Border>
</UserControl>
