<UserControl x:Class="StayEasy.UI.Controles.BotonUsuarioAnimado"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Raiz"
             Height="42"
             HorizontalAlignment="Left">

    <!-- Botón de usuario animado: en reposo es verde; al pasar el cursor
         pasa a rojo y crece 100 px de ancho. Las animaciones se disparan
         desde el code-behind porque el ancho final depende de AnchoBase. -->

    <Button x:Name="Btn" Cursor="Hand" Click="Btn_Click"
            FontSize="14" FontWeight="Medium" Foreground="White"
            Content="{Binding Texto, ElementName=Raiz}">
        <Button.Background>
            <!-- Pincel propio (no congelado) para poder animar el color. -->
            <SolidColorBrush x:Name="Pincel" Color="#2E9E5B" />
        </Button.Background>
        <Button.Template>
            <ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" CornerRadius="21" Padding="20,0">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>
            </ControlTemplate>
        </Button.Template>
    </Button>
</UserControl>
