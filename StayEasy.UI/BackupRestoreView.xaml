<Window x:Class="StayEasy.UI.BackupRestoreView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayEasy · Backup, Restore y Persistencia XML"
        Width="1180" Height="860"
        MinWidth="960" MinHeight="720"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        Icon="/Assets/stayeasy-marca-claro.ico"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

    <!-- Ventana MDI de Administración: Backup / Restore (sp_BackupBaseDatos y usp_Restore_StayEasyDB)
         + Persistencia XML (XmlHelper<T>). Comparte la paleta monocroma de Dashboard y Reservas. -->

    <Window.Resources>

        <SolidColorBrush x:Key="Ink"       Color="#1C1C1C" />
        <SolidColorBrush x:Key="Paper"     Color="#FFFFFF" />
        <SolidColorBrush x:Key="Shell"     Color="#F2F2F2" />
        <SolidColorBrush x:Key="Text"      Color="#1A1A1A" />
        <SolidColorBrush x:Key="TextSoft"  Color="#5C5C5C" />
        <SolidColorBrush x:Key="Muted"     Color="#8A8A8A" />
        <SolidColorBrush x:Key="Faint"     Color="#A3A3A3" />
        <SolidColorBrush x:Key="Line"      Color="#E2E2E2" />
        <SolidColorBrush x:Key="LineSoft"  Color="#EDEDED" />
        <SolidColorBrush x:Key="Field"     Color="#F7F7F7" />
        <SolidColorBrush x:Key="DarkTile"  Color="#262626" />
        <SolidColorBrush x:Key="DarkLine"  Color="#333333" />
        <SolidColorBrush x:Key="Danger"    Color="#A8322B" />
        <SolidColorBrush x:Key="Success"   Color="#2E7D32" />

        <Style x:Key="Card" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Paper}" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="24,22" />
            <Setter Property="Margin" Value="0,0,0,14" />
        </Style>

        <Style x:Key="CardDark" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="CornerRadius" Value="22" />
            <Setter Property="Padding" Value="24,22" />
        </Style>

        <Style x:Key="SectionNum" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#C4C4C4" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,0,10,0" />
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource TextSoft}" />
            <Setter Property="Margin" Value="0,0,0,6" />
        </Style>

        <Style x:Key="RoundInput" TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="CaretBrush" Value="{StaticResource Ink}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="Bd" Background="{StaticResource Field}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="12,0">
                            <ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#CFCFCF" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Paper}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillPrimary" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="22,0" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Paper}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Ink}" CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#000000" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="#DCDCDC" />
                                <Setter Property="Foreground" Value="{StaticResource Muted}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillOutline" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="18,0" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Text}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{StaticResource Paper}" BorderBrush="#DCDCDC" BorderThickness="1"
                                CornerRadius="21" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
                                <Setter TargetName="Bd" Property="Background" Value="#F9F9F9" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TagDark" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Ink}" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <Border x:Name="MarcoModal" Background="#70121212" Padding="24">
        <Border Background="{StaticResource Shell}" CornerRadius="28" ClipToBounds="True">
            <Border.Effect>
                <DropShadowEffect BlurRadius="60" ShadowDepth="14" Opacity="0.34" Color="#000000" />
            </Border.Effect>

            <DockPanel LastChildFill="True">

                <!-- ================= Encabezado ================= -->
                <Border x:Name="BarraEncabezado" DockPanel.Dock="Top" Background="{StaticResource Paper}"
                        Padding="28,20,28,18" MouseLeftButtonDown="BarraEncabezado_MouseLeftButtonDown">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="ADMINISTRACIÓN · CONTINUIDAD OPERATIVA" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Faint}" />
                            <TextBlock Text="Backup, Restore y Persistencia XML" FontSize="23" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" Margin="0,3,0,0" />
                        </StackPanel>

                        <Border Grid.Column="1" Style="{StaticResource TagDark}" Margin="0,0,12,0">
                            <TextBlock x:Name="Lbl_UsuarioActivo" Text="StayEasyDB · SQL Server" FontSize="11.5"
                                       FontWeight="Medium" Foreground="{StaticResource Paper}" />
                        </Border>

                        <Button Grid.Column="2" x:Name="Btn_Cerrar" Width="38" Height="38" Cursor="Hand"
                                VerticalAlignment="Center" ToolTip="Volver al Dashboard" Click="Btn_Cerrar_Click">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{StaticResource Shell}" CornerRadius="19">
                                        <Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#5C5C5C" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E4E4E4" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>
                </Border>

                <!-- ================= Pie de estado ================= -->
                <Border DockPanel.Dock="Bottom" Background="{StaticResource Paper}" Padding="28,14"
                        BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Ellipse x:Name="Dot_Estado" Width="9" Height="9" Fill="{StaticResource Ink}"
                                 VerticalAlignment="Center" Margin="0,0,10,0" />
                        <TextBlock Grid.Column="1" x:Name="Lbl_EstadoOperacion"
                                   Text="Listo para ejecutar operaciones de resguardo o serialización XML."
                                   FontSize="12.5" Foreground="{StaticResource TextSoft}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" />
                        <Button Grid.Column="2" x:Name="Btn_Volver" Content="Volver al panel"
                                Style="{StaticResource PillOutline}" Height="36" Padding="18,0"
                                Click="Btn_Cerrar_Click" />
                    </Grid>
                </Border>

                <!-- ================= Cuerpo MDI ================= -->
                <Grid x:Name="Pnl_ContenidoMdi" Margin="26,18,26,18">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="1.35*" MinWidth="500" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="1*" MinWidth="360" />
                    </Grid.ColumnDefinitions>

                    <!-- Columna izquierda: 01 Backup, 02 Restore, 03 XML -->
                    <ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                        <StackPanel>

                            <!-- ================= 01 · Backup de Base de Datos ================= -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="01" Style="{StaticResource SectionNum}" />
                                        <TextBlock Grid.Column="1" Text="Generar Copia de Seguridad (Backup)" Style="{StaticResource SectionTitle}" />
                                        <Border Grid.Column="2" Background="#F2F2F2" CornerRadius="8" Padding="8,3">
                                            <TextBlock Text="SP: sp_BackupBaseDatos (@RutaArchivo)" FontSize="11"
                                                       FontWeight="Medium" Foreground="{StaticResource TextSoft}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Genera un resguardo completo (.bak) de StayEasyDB en disco y registra la auditoría en XML."
                                               FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,14" />

                                    <TextBlock Text="Ruta destino del archivo (.bak)" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="Txt_RutaBackup" Style="{StaticResource RoundInput}" />
                                        <Button Grid.Column="2" x:Name="Btn_ExaminarBackup" Content="Examinar…"
                                                Style="{StaticResource PillOutline}" Click="Btn_ExaminarBackup_Click" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                        <Button x:Name="Btn_EjecutarBackup" Content="Ejecutar Backup (.bak)"
                                                Style="{StaticResource PillPrimary}" Click="Btn_EjecutarBackup_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ================= 02 · Restore de Base de Datos ================= -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="02" Style="{StaticResource SectionNum}" />
                                        <TextBlock Grid.Column="1" Text="Restaurar Base de Datos (Restore)" Style="{StaticResource SectionTitle}" />
                                        <Border Grid.Column="2" Background="#F2F2F2" CornerRadius="8" Padding="8,3">
                                            <TextBlock Text="SP: usp_Restore_StayEasyDB / sp_RestoreBaseDatos" FontSize="11"
                                                       FontWeight="Medium" Foreground="{StaticResource TextSoft}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Restaura StayEasyDB a partir de un archivo .bak existente (cierra conexiones activas con SINGLE_USER y REPLACE)."
                                               FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,14"
                                               TextWrapping="Wrap" />

                                    <TextBlock Text="Archivo de origen (.bak)" Style="{StaticResource FieldLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="Txt_RutaRestore" Style="{StaticResource RoundInput}" />
                                        <Button Grid.Column="2" x:Name="Btn_ExaminarRestore" Content="Seleccionar .bak…"
                                                Style="{StaticResource PillOutline}" Click="Btn_ExaminarRestore_Click" />
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
                                        <Button x:Name="Btn_EjecutarRestore" Content="Restaurar Base de Datos"
                                                Style="{StaticResource PillPrimary}" Click="Btn_EjecutarRestore_Click" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!-- ================= 03 · Persistencia XML (XmlHelper<T>) ================= -->
                            <Border Style="{StaticResource Card}" Margin="0">
                                <StackPanel>
                                    <Grid Margin="0,0,0,6">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Text="03" Style="{StaticResource SectionNum}" />
                                        <TextBlock Grid.Column="1" Text="Persistencia XML (XmlHelper&lt;T&gt;)" Style="{StaticResource SectionTitle}" />
                                        <Border Grid.Column="2" Background="#F2F2F2" CornerRadius="8" Padding="8,3">
                                            <TextBlock Text="XmlSerializer · UTF-8" FontSize="11"
                                                       FontWeight="Medium" Foreground="{StaticResource TextSoft}" />
                                        </Border>
                                    </Grid>

                                    <TextBlock Text="Exporta e importa entidades del sistema (Reservas y Catálogo de Backups) utilizando XmlHelper&lt;T&gt;."
                                               FontSize="12.5" Foreground="{StaticResource Muted}" Margin="0,0,0,14"
                                               TextWrapping="Wrap" />

                                    <WrapPanel Orientation="Horizontal">
                                        <Button x:Name="Btn_ExportarReservasXml" Content="Exportar Reservas a XML"
                                                Style="{StaticResource PillOutline}" Margin="0,0,10,8"
                                                Click="Btn_ExportarReservasXml_Click" />
                                        <Button x:Name="Btn_ImportarReservasXml" Content="Leer Reservas desde XML"
                                                Style="{StaticResource PillOutline}" Margin="0,0,10,8"
                                                Click="Btn_ImportarReservasXml_Click" />
                                        <Button x:Name="Btn_VerXmlHistorial" Content="Ver XML del Historial"
                                                Style="{StaticResource PillOutline}" Margin="0,0,0,8"
                                                Click="Btn_VerXmlHistorial_Click" />
                                    </WrapPanel>

                                    <TextBlock Text="Vista previa del documento XML serializado" Style="{StaticResource FieldLabel}" Margin="0,6,0,6" />
                                    <Border Background="{StaticResource Field}" BorderBrush="{StaticResource Line}"
                                            BorderThickness="1" CornerRadius="12" Padding="12,10" Height="150">
                                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                                            <TextBox x:Name="Txt_PreviewXml" IsReadOnly="True" BorderThickness="0"
                                                     Background="Transparent" FontFamily="Consolas" FontSize="11.5"
                                                     Foreground="{StaticResource Text}" TextWrapping="NoWrap" />
                                        </ScrollViewer>
                                    </Border>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <!-- Columna derecha: Historial XML de Backups/Restores -->
                    <Border Grid.Column="2" Style="{StaticResource CardDark}">
                        <DockPanel LastChildFill="True">

                            <StackPanel DockPanel.Dock="Top">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Catálogo XML de Operaciones" FontSize="16" FontWeight="SemiBold"
                                                   Foreground="{StaticResource Paper}" />
                                        <TextBlock Text="Persistido con XmlHelper&lt;RegistroBackupXml&gt;" FontSize="11.5"
                                                   Foreground="#9A9A9A" Margin="0,3,0,0" />
                                    </StackPanel>
                                    <Border Grid.Column="1" Background="#333333" CornerRadius="10" Padding="9,4"
                                            VerticalAlignment="Top">
                                        <TextBlock x:Name="Lbl_ContadorHistorial" Text="0 registros" FontSize="11"
                                                   FontWeight="Medium" Foreground="{StaticResource Paper}" />
                                    </Border>
                                </Grid>

                                <TextBlock Text="Hacé clic en un backup del historial para cargar su ruta en el panel de Restore."
                                           FontSize="11.5" Foreground="#8F8F8F" Margin="0,12,0,14" TextWrapping="Wrap" />
                            </StackPanel>

                            <ListBox x:Name="Lst_HistorialXml" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                     SelectionChanged="Lst_HistorialXml_SelectionChanged">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,10" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="Cursor" Value="Hand" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="{StaticResource DarkTile}"
                                                            BorderBrush="{StaticResource DarkLine}" BorderThickness="1"
                                                            CornerRadius="14" Padding="14,12">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#5C5C5C" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="#FFFFFF" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Border Background="#FFFFFF" CornerRadius="6" Padding="7,2">
                                                    <TextBlock Text="{Binding TipoOperacion}" FontSize="10.5"
                                                               FontWeight="Bold" Foreground="#1C1C1C" />
                                                </Border>
                                                <TextBlock Grid.Column="1" Text="{Binding NombreArchivo}" FontSize="13"
                                                           FontWeight="SemiBold" Foreground="#FFFFFF" Margin="8,0"
                                                           VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                                <TextBlock Grid.Column="2" Text="{Binding TamanoFormateado}" FontSize="11.5"
                                                           Foreground="#A3A3A3" VerticalAlignment="Center" />
                                            </Grid>
                                            <TextBlock Text="{Binding RutaArchivoBak}" FontSize="11"
                                                       Foreground="#8A8A8A" Margin="0,6,0,0"
                                                       TextTrimming="CharacterEllipsis" />
                                            <Grid Margin="0,6,0,0">
                                                <TextBlock Text="{Binding FechaFormateada}" FontSize="11" Foreground="#9A9A9A" />
                                                <TextBlock Text="{Binding ProcedimientoEjecutado}" FontSize="11"
                                                           Foreground="#9A9A9A" HorizontalAlignment="Right" />
                                            </Grid>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                        </DockPanel>
                    </Border>

                </Grid>
            </DockPanel>
        </Border>
    </Border>
</Window>
