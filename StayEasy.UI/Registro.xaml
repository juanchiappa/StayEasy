<Window x:Class="StayEasy.UI.Registro"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayEasy · Crear cuenta"
        Width="1280" Height="900"
        MinWidth="1024" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Background="#E6E6E6">

    <!-- Registro (mockup monocromo). Misma paleta local que Login.xaml: es
         una ventana previa al shell y no consume StayEasy.Tokens a propósito. -->

    <Window.Resources>

        <!-- ================= Paleta ================= -->
        <SolidColorBrush x:Key="Rg.Bg"          Color="#E6E6E6" />
        <SolidColorBrush x:Key="Rg.Glass"       Color="#6BFFFFFF" />
        <SolidColorBrush x:Key="Rg.GlassBorder" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="Rg.Card"        Color="#FFFFFF" />
        <SolidColorBrush x:Key="Rg.Dark"        Color="#1C1C1C" />
        <SolidColorBrush x:Key="Rg.DarkHover"   Color="#000000" />
        <SolidColorBrush x:Key="Rg.Pressed"     Color="#3A3A3A" />
        <SolidColorBrush x:Key="Rg.OnDark"      Color="#FFFFFF" />
        <SolidColorBrush x:Key="Rg.OnDarkMuted" Color="#A8A8A8" />
        <SolidColorBrush x:Key="Rg.OnDarkFaint" Color="#8F8F8F" />
        <SolidColorBrush x:Key="Rg.Text"        Color="#1A1A1A" />
        <SolidColorBrush x:Key="Rg.TextBody"    Color="#3D3D3D" />
        <SolidColorBrush x:Key="Rg.TextMuted"   Color="#8A8A8A" />
        <SolidColorBrush x:Key="Rg.TextFaint"   Color="#A3A3A3" />
        <SolidColorBrush x:Key="Rg.Label"       Color="#5C5C5C" />
        <SolidColorBrush x:Key="Rg.Field"       Color="#F6F6F6" />
        <SolidColorBrush x:Key="Rg.FieldBorder" Color="#E4E4E4" />
        <SolidColorBrush x:Key="Rg.Track"       Color="#F0F0F0" />
        <SolidColorBrush x:Key="Rg.Disabled"    Color="#E4E4E4" />

        <!-- ================= Tipografía ================= -->
        <Style x:Key="Rg.Display" TargetType="TextBlock">
            <Setter Property="FontSize" Value="40" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="44" />
            <Setter Property="Foreground" Value="{StaticResource Rg.OnDark}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Rg.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Rg.Text}" />
        </Style>
        <Style x:Key="Rg.Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{StaticResource Rg.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="Rg.FieldLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Rg.Label}" />
            <Setter Property="Margin" Value="0,0,0,7" />
        </Style>

        <!-- ================= Campos ================= -->
        <!-- El Border exterior dibuja el radio y reacciona al foco; el
             TextBox/PasswordBox interior va sin borde ni fondo. -->
        <Style x:Key="Rg.FieldShell" TargetType="Border">
            <Setter Property="Height" Value="48" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource Rg.Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Rg.FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="15,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Rg.Dark}" />
                    <Setter Property="Background" Value="{StaticResource Rg.Card}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Rg.Input" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{StaticResource Rg.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Rg.Text}" />
        </Style>

        <Style x:Key="Rg.InputPassword" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{StaticResource Rg.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Rg.Text}" />
        </Style>

        <!-- Placeholder: el code-behind alterna Visibility en TextChanged -->
        <Style x:Key="Rg.Placeholder" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14.5" />
            <Setter Property="Foreground" Value="{StaticResource Rg.TextFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ================= Botones ================= -->
        <Style x:Key="Rg.Button.Primary" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Rg.OnDark}" />
            <Setter Property="Background" Value="{StaticResource Rg.Dark}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter x:Name="Cp" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Rg.DarkHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Rg.Pressed}" />
                            </Trigger>
                            <!-- Deshabilitado: el mockup lo muestra gris plano,
                                 no translúcido. -->
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Rg.Disabled}" />
                                <Setter Property="Foreground" Value="{StaticResource Rg.TextFaint}" />
                                <Setter Property="Cursor" Value="No" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Rg.Button.Link" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Rg.Dark}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Ojo de contraseña: afecta a los dos campos a la vez -->
        <Style x:Key="Rg.Button.Eye" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Rg.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <Path x:Name="Ic" Width="18" Height="18" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M2,12 C2,12 5.6,5.5 12,5.5 C18.4,5.5 22,12 22,12 C22,12 18.4,18.5 12,18.5 C5.6,18.5 2,12 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEEEEE" />
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Rg.Dark}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Rg.Dark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Rol: píldoras exclusivas -->
        <Style x:Key="Rg.RolePill" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Rol" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Rg.Label}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" CornerRadius="19" Padding="16,0"
                                Background="{StaticResource Rg.Card}"
                                BorderBrush="{StaticResource Rg.FieldBorder}" BorderThickness="1">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}"
                                       VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Rg.Field}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Rg.Dark}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Rg.Dark}" />
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Rg.OnDark}" />
                                <Setter TargetName="Tx" Property="FontWeight" Value="Medium" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Checkbox cuadrado con radio -->
        <Style x:Key="Rg.CheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource Rg.TextBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" x:Name="Box" Width="20" Height="20" CornerRadius="6"
                                    Background="{StaticResource Rg.Card}"
                                    BorderBrush="#CFCFCF" BorderThickness="1"
                                    VerticalAlignment="Top" Margin="0,1,0,0">
                                <Path x:Name="Tick" Visibility="Collapsed" Width="11" Height="11" Stretch="Uniform"
                                      Stroke="{StaticResource Rg.OnDark}" StrokeThickness="2.5"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Data="M4,12.5 L9.5,18 L20,6"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Grid.Column="1" Margin="11,0,0,0" VerticalAlignment="Center" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Rg.Dark}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Rg.Dark}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Rg.Label}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Chip del campo usuario (disponible / muy corto) -->
        <Style x:Key="Rg.Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Rg.Dark}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="9,3" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Rg.ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Rg.OnDark}" />
        </Style>

        <!-- Segmento del medidor de fuerza -->
        <Style x:Key="Rg.StrengthSeg" TargetType="Border">
            <Setter Property="Height" Value="4" />
            <Setter Property="CornerRadius" Value="2" />
            <Setter Property="Background" Value="{StaticResource Rg.Track}" />
        </Style>

        <!-- Requisito de contraseña: punto + texto -->
        <Style x:Key="Rg.ReqText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Rg.TextFaint}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

    </Window.Resources>

    <!-- ================= Fondo ================= -->
    <Grid Background="{StaticResource Rg.Bg}" ClipToBounds="True">

        <Ellipse Width="900" Height="900" Margin="-160,-300,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35" RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="760" Height="760" Margin="0,0,-140,-260"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.55,0.45" GradientOrigin="0.55,0.45" RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="#FFCFCFCF" Offset="0" />
                    <GradientStop Color="#00CFCFCF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ================= Contenedor "vidrio" ================= -->
        <Border MaxWidth="1120" Margin="40"
                Background="{StaticResource Rg.Glass}"
                BorderBrush="{StaticResource Rg.GlassBorder}" BorderThickness="1"
                CornerRadius="32" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="60" ShadowDepth="14" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="380" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" MinWidth="380" />
                </Grid.ColumnDefinitions>

                <!-- ==================== Panel oscuro ==================== -->
                <Border Grid.Column="0" Background="{StaticResource Rg.Dark}" CornerRadius="24" Padding="40">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Marca -->
                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10" Background="{StaticResource Rg.OnDark}">
                                <TextBlock Text="S" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource Rg.Dark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="StayEasy" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Rg.OnDark}" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- Claim -->
                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,40">
                            <TextBlock Style="{StaticResource Rg.Display}">
                                Creá tu cuenta<LineBreak />y empezá a operar.
                            </TextBlock>
                            <TextBlock Text="Una cuenta por persona del equipo. El acceso a cada módulo depende del rol."
                                       Margin="0,18,0,0" MaxWidth="360" FontSize="16" LineHeight="24"
                                       Foreground="{StaticResource Rg.OnDarkMuted}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!-- Tres razones -->
                        <StackPanel Grid.Row="2">

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                        Background="{StaticResource Rg.OnDark}" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="Transparent"
                                          Stroke="{StaticResource Rg.Dark}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4,12.5 L9.5,18 L20,6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Un rol, un tablero" FontSize="14" FontWeight="Medium"
                                               Foreground="{StaticResource Rg.OnDark}" />
                                    <TextBlock Text="Recepción ve reservas y check-in; limpieza ve solo sus tareas."
                                               FontSize="12.5" LineHeight="18" Margin="0,2,0,0"
                                               Foreground="{StaticResource Rg.OnDarkFaint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                        Background="{StaticResource Rg.OnDark}" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="Transparent"
                                          Stroke="{StaticResource Rg.Dark}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4,12.5 L9.5,18 L20,6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Todo queda registrado" FontSize="14" FontWeight="Medium"
                                               Foreground="{StaticResource Rg.OnDark}" />
                                    <TextBlock Text="Cada cargo, check-in y cierre de cuenta guarda quién lo hizo."
                                               FontSize="12.5" LineHeight="18" Margin="0,2,0,0"
                                               Foreground="{StaticResource Rg.OnDarkFaint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Grid.Column="0" Width="24" Height="24" CornerRadius="8"
                                        Background="{StaticResource Rg.OnDark}" VerticalAlignment="Top" Margin="0,1,0,0">
                                    <Path Width="13" Height="13" Stretch="Uniform" Fill="Transparent"
                                          Stroke="{StaticResource Rg.Dark}" StrokeThickness="3"
                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Data="M4,12.5 L9.5,18 L20,6"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <StackPanel Grid.Column="1" Margin="13,0,0,0">
                                    <TextBlock Text="Sin instalación por puesto" FontSize="14" FontWeight="Medium"
                                               Foreground="{StaticResource Rg.OnDark}" />
                                    <TextBlock Text="La cuenta funciona en cualquier terminal del hotel."
                                               FontSize="12.5" LineHeight="18" Margin="0,2,0,0"
                                               Foreground="{StaticResource Rg.OnDarkFaint}" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- ==================== Formulario ==================== -->
                <Border Grid.Column="2" Background="{StaticResource Rg.Card}" CornerRadius="24" Padding="40,40,40,34">
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>

                            <TextBlock Text="Registrate" Style="{StaticResource Rg.Heading}" />
                            <TextBlock Text="Completá los datos del personal. Un administrador confirma la cuenta."
                                       Style="{StaticResource Rg.Body}" Margin="0,8,0,0" />

                            <!-- ==================== Nombre y apellido ==================== -->
                            <Grid Margin="0,22,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Nombre" Style="{StaticResource Rg.FieldLabel}" />
                                    <Border Style="{StaticResource Rg.FieldShell}">
                                        <Grid>
                                            <TextBlock x:Name="Ph_Nombre" Text="Marina"
                                                       Style="{StaticResource Rg.Placeholder}" />
                                            <TextBox x:Name="Txt_Nombre" Style="{StaticResource Rg.Input}" TabIndex="1" />
                                        </Grid>
                                    </Border>
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Apellido" Style="{StaticResource Rg.FieldLabel}" />
                                    <Border Style="{StaticResource Rg.FieldShell}">
                                        <Grid>
                                            <TextBlock x:Name="Ph_Apellido" Text="Ríos"
                                                       Style="{StaticResource Rg.Placeholder}" />
                                            <TextBox x:Name="Txt_Apellido" Style="{StaticResource Rg.Input}" TabIndex="2" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Grid>

                            <!-- ==================== Correo ==================== -->
                            <TextBlock Text="Correo de trabajo" Style="{StaticResource Rg.FieldLabel}" Margin="0,15,0,7" />
                            <Border Style="{StaticResource Rg.FieldShell}">
                                <Grid>
                                    <TextBlock x:Name="Ph_Correo" Text="nombre@hotel.com"
                                               Style="{StaticResource Rg.Placeholder}" />
                                    <TextBox x:Name="Txt_Correo" Style="{StaticResource Rg.Input}" TabIndex="3" />
                                </Grid>
                            </Border>

                            <!-- ==================== Usuario + chip de disponibilidad ==================== -->
                            <TextBlock Text="Usuario" Style="{StaticResource Rg.FieldLabel}" Margin="0,15,0,7" />
                            <Border Style="{StaticResource Rg.FieldShell}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0" Margin="0,0,10,0">
                                        <TextBlock x:Name="Ph_Usuario" Text="mrios"
                                                   Style="{StaticResource Rg.Placeholder}" />
                                        <TextBox x:Name="Txt_Usuario" Style="{StaticResource Rg.Input}" TabIndex="4" />
                                    </Grid>
                                    <!-- Chip: fondo negro cuando está disponible, gris cuando
                                         el usuario es muy corto (lo cambia el code-behind). -->
                                    <Border Grid.Column="1" x:Name="Chip_Usuario" Style="{StaticResource Rg.Chip}">
                                        <TextBlock x:Name="Lbl_ChipUsuario" Text="Disponible"
                                                   Style="{StaticResource Rg.ChipText}" />
                                    </Border>
                                </Grid>
                            </Border>

                            <!-- ==================== Rol ==================== -->
                            <TextBlock Text="Rol" Style="{StaticResource Rg.FieldLabel}" Margin="0,15,0,7" />
                            <StackPanel Orientation="Horizontal">
                                <RadioButton x:Name="Rol_Recepcion" Content="Recepción" IsChecked="True"
                                             Style="{StaticResource Rg.RolePill}" TabIndex="5" />
                                <RadioButton x:Name="Rol_Limpieza" Content="Limpieza"
                                             Style="{StaticResource Rg.RolePill}" TabIndex="6" />
                                <RadioButton x:Name="Rol_Administracion" Content="Administración"
                                             Style="{StaticResource Rg.RolePill}" Margin="0" TabIndex="7" />
                            </StackPanel>

                            <!-- ==================== Contraseña ==================== -->
                            <TextBlock Text="Contraseña" Style="{StaticResource Rg.FieldLabel}" Margin="0,15,0,7" />
                            <Border Style="{StaticResource Rg.FieldShell}" Padding="15,0,7,0">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="0">
                                        <TextBlock x:Name="Ph_Password" Text="Mínimo 8 caracteres"
                                                   Style="{StaticResource Rg.Placeholder}" />
                                        <PasswordBox x:Name="Pwd_Password" Style="{StaticResource Rg.InputPassword}"
                                                     TabIndex="8" />
                                        <!-- Contraseña visible: el ojo alterna Visibility entre
                                             los dos y sincroniza el valor. -->
                                        <TextBox x:Name="Txt_PasswordVisible" Style="{StaticResource Rg.Input}"
                                                 Visibility="Collapsed" />
                                    </Grid>
                                    <ToggleButton x:Name="Btn_VerPassword" Grid.Column="1"
                                                  Style="{StaticResource Rg.Button.Eye}"
                                                  ToolTip="Mostrar contraseña"
                                                  VerticalAlignment="Center" TabIndex="9" />
                                </Grid>
                            </Border>

                            <!-- ==================== Medidor de fuerza ==================== -->
                            <Grid Margin="0,15,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid Grid.Column="0" VerticalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- El code-behind pinta los primeros N segmentos con el
                                         tono correspondiente al puntaje. -->
                                    <Border Grid.Column="0" x:Name="Seg_1" Style="{StaticResource Rg.StrengthSeg}" />
                                    <Border Grid.Column="2" x:Name="Seg_2" Style="{StaticResource Rg.StrengthSeg}" />
                                    <Border Grid.Column="4" x:Name="Seg_3" Style="{StaticResource Rg.StrengthSeg}" />
                                    <Border Grid.Column="6" x:Name="Seg_4" Style="{StaticResource Rg.StrengthSeg}" />
                                </Grid>
                                <TextBlock Grid.Column="1" x:Name="Lbl_Fuerza" Text="Muy débil" Margin="10,0,0,0"
                                           FontSize="11.5" FontWeight="Medium" Foreground="{StaticResource Rg.Label}"
                                           VerticalAlignment="Center" />
                            </Grid>

                            <!-- ==================== Requisitos ==================== -->
                            <StackPanel Orientation="Horizontal" Margin="0,9,0,0">
                                <Ellipse x:Name="Dot_Req1" Width="13" Height="13" Fill="Transparent"
                                         Stroke="#D4D4D4" StrokeThickness="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="Lbl_Req1" Text="8 caracteres" Margin="6,0,14,0"
                                           Style="{StaticResource Rg.ReqText}" />
                                <Ellipse x:Name="Dot_Req2" Width="13" Height="13" Fill="Transparent"
                                         Stroke="#D4D4D4" StrokeThickness="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="Lbl_Req2" Text="Una mayúscula" Margin="6,0,14,0"
                                           Style="{StaticResource Rg.ReqText}" />
                                <Ellipse x:Name="Dot_Req3" Width="13" Height="13" Fill="Transparent"
                                         Stroke="#D4D4D4" StrokeThickness="1" VerticalAlignment="Center" />
                                <TextBlock x:Name="Lbl_Req3" Text="Un número" Margin="6,0,0,0"
                                           Style="{StaticResource Rg.ReqText}" />
                            </StackPanel>

                            <!-- ==================== Repetir contraseña ==================== -->
                            <TextBlock Text="Repetir contraseña" Style="{StaticResource Rg.FieldLabel}" Margin="0,15,0,7" />
                            <Border x:Name="Shell_Password2" Style="{StaticResource Rg.FieldShell}">
                                <Grid>
                                    <TextBlock x:Name="Ph_Password2" Text="Volvé a escribirla"
                                               Style="{StaticResource Rg.Placeholder}" />
                                    <PasswordBox x:Name="Pwd_Password2" Style="{StaticResource Rg.InputPassword}"
                                                 TabIndex="10" />
                                    <TextBox x:Name="Txt_Password2Visible" Style="{StaticResource Rg.Input}"
                                             Visibility="Collapsed" />
                                </Grid>
                            </Border>
                            <!-- Mensaje de coincidencia; oculto mientras el campo esté vacío -->
                            <TextBlock x:Name="Lbl_Coincidencia" Text="Las contraseñas coinciden"
                                       FontSize="11.5" Margin="0,4,0,0" Visibility="Collapsed"
                                       Foreground="{StaticResource Rg.TextMuted}" />

                            <!-- ==================== Condiciones ==================== -->
                            <CheckBox x:Name="Chk_Terminos" Margin="0,18,0,0"
                                      Style="{StaticResource Rg.CheckBox}" TabIndex="11">
                                <TextBlock Text="Acepto las condiciones de uso y el tratamiento de los datos de huéspedes según la política del hotel."
                                           FontSize="13" LineHeight="19"
                                           Foreground="{StaticResource Rg.TextBody}" TextWrapping="Wrap" />
                            </CheckBox>

                            <!-- ==================== Acción ==================== -->
                            <!-- Arranca deshabilitado: el code-behind lo habilita cuando el
                                 usuario es válido, la contraseña es aceptable, coincide y
                                 las condiciones están aceptadas. -->
                            <Button x:Name="Btn_CrearCuenta" Content="Crear cuenta"
                                    Style="{StaticResource Rg.Button.Primary}"
                                    Margin="0,22,0,0" IsEnabled="False" IsDefault="True" TabIndex="12" />

                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,14,0,0">
                                <TextBlock Text="¿Ya tenés cuenta?" FontSize="14"
                                           Foreground="{StaticResource Rg.TextMuted}" VerticalAlignment="Center" />
                                <Button x:Name="Btn_IniciarSesion" Content="Iniciá sesión" Margin="6,0,0,0"
                                        Style="{StaticResource Rg.Button.Link}"
                                        VerticalAlignment="Center" TabIndex="13" />
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
