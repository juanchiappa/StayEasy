<Window x:Class="StayEasy.UI.Reservas"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controles="clr-namespace:StayEasy.UI.Controles"
        Title="Nueva reserva"
        Width="1160" Height="880"
        WindowStartupLocation="CenterOwner"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="CanResize"
        FontFamily="Inter Tight, Segoe UI"
        TextOptions.TextFormattingMode="Ideal">

	<!-- Reservas · Nueva reserva  (ventana + code-behind en ReservaNueva.xaml.cs) — modal sobre el dashboard, estado limpio.
         Campos que completa: ID_Reserva, ID_Huesped, Habitacion, FechaCheckIn,
         FechaChekOut, Estado (EstadoReserva) y Total. Los servicios exponen
         Nombre, Precio y EsCombo (etiqueta "Combo" + descuento del 15 %).
         Paleta monocroma propia del dashboard: no usa Tokens.xaml. -->

	<Window.Resources>

		<SolidColorBrush x:Key="Ink"       Color="#1C1C1C" />
		<SolidColorBrush x:Key="Paper"     Color="#FFFFFF" />
		<SolidColorBrush x:Key="Shell"     Color="#F2F2F2" />
		<SolidColorBrush x:Key="Text"      Color="#1A1A1A" />
		<SolidColorBrush x:Key="TextSoft"  Color="#6B6B6B" />
		<SolidColorBrush x:Key="Muted"     Color="#8A8A8A" />
		<SolidColorBrush x:Key="Faint"     Color="#A3A3A3" />
		<SolidColorBrush x:Key="Line"      Color="#E2E2E2" />
		<SolidColorBrush x:Key="LineSoft"  Color="#EDEDED" />
		<SolidColorBrush x:Key="Field"     Color="#F7F7F7" />
		<SolidColorBrush x:Key="DarkRow"   Color="#2A2A2A" />
		<SolidColorBrush x:Key="DarkLine"  Color="#3A3A3A" />
		<SolidColorBrush x:Key="DarkText"  Color="#9A9A9A" />
		<SolidColorBrush x:Key="Danger"    Color="#A8322B" />

		<!-- Tarjeta blanca de sección -->
		<Style x:Key="Card" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource Paper}" />
			<Setter Property="CornerRadius" Value="20" />
			<Setter Property="Padding" Value="24,22" />
			<Setter Property="Margin" Value="0,0,0,12" />
		</Style>

		<Style x:Key="SectionNum" TargetType="TextBlock">
			<Setter Property="FontSize" Value="11" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="#C4C4C4" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="Margin" Value="0,0,10,0" />
		</Style>

		<Style x:Key="SectionTitle" TargetType="TextBlock">
			<Setter Property="FontSize" Value="15.5" />
			<Setter Property="FontWeight" Value="SemiBold" />
			<Setter Property="Foreground" Value="{StaticResource Text}" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="SectionAside" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12.5" />
			<Setter Property="Foreground" Value="{StaticResource Muted}" />
			<Setter Property="VerticalAlignment" Value="Center" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>

		<Style x:Key="FieldLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{StaticResource TextSoft}" />
			<Setter Property="Margin" Value="0,0,0,6" />
		</Style>

		<!-- Campo de texto redondeado, 42 px -->
		<Style x:Key="RoundInput" TargetType="TextBox">
			<Setter Property="Height" Value="42" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="Foreground" Value="{StaticResource Text}" />
			<Setter Property="CaretBrush" Value="{StaticResource Ink}" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" Background="{StaticResource Paper}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="12" Padding="12,0">
							<ScrollViewer x:Name="PART_ContentHost" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#CFCFCF" />
							</Trigger>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Área de notas -->
		<Style x:Key="NotesInput" TargetType="TextBox" BasedOn="{StaticResource RoundInput}">
			<Setter Property="Height" Value="86" />
			<Setter Property="AcceptsReturn" Value="True" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="VerticalContentAlignment" Value="Top" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="TextBox">
						<Border x:Name="Bd" Background="{StaticResource Paper}"
                                BorderBrush="{StaticResource Line}" BorderThickness="1"
                                CornerRadius="14" Padding="14,12">
							<ScrollViewer x:Name="PART_ContentHost" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsKeyboardFocused" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Combos redondeados -->
		<Style x:Key="RoundCombo" TargetType="ComboBox">
			<Setter Property="Height" Value="42" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="Padding" Value="11,0" />
			<Setter Property="Foreground" Value="{StaticResource Text}" />
			<Setter Property="Background" Value="{StaticResource Paper}" />
			<Setter Property="BorderBrush" Value="{StaticResource Line}" />
			<Setter Property="VerticalContentAlignment" Value="Center" />
		</Style>

		<!-- Botón negro tipo píldora -->
		<Style x:Key="PillPrimary" TargetType="Button">
			<Setter Property="Height" Value="42" />
			<Setter Property="Padding" Value="22,0" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{StaticResource Ink}" CornerRadius="21" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="#000000" />
							</Trigger>
							<Trigger Property="IsEnabled" Value="False">
								<Setter TargetName="Bd" Property="Background" Value="#DCDCDC" />
								<Setter Property="Foreground" Value="{StaticResource Muted}" />
								<Setter Property="Cursor" Value="No" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Botón contorneado tipo píldora -->
		<Style x:Key="PillOutline" TargetType="Button">
			<Setter Property="Height" Value="42" />
			<Setter Property="Padding" Value="20,0" />
			<Setter Property="FontSize" Value="13.5" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{StaticResource Text}" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="{StaticResource Paper}" BorderBrush="#E0E0E0" BorderThickness="1"
                                CornerRadius="21" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Botón sin fondo -->
		<Style x:Key="PillGhost" TargetType="Button" BasedOn="{StaticResource PillOutline}">
			<Setter Property="Foreground" Value="{StaticResource TextSoft}" />
			<Setter Property="Padding" Value="18,0" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="Button">
						<Border x:Name="Bd" Background="Transparent" CornerRadius="21" Padding="{TemplateBinding Padding}">
							<ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource Shell}" />
								<Setter Property="Foreground" Value="{StaticResource Ink}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Píldora de opción (medio de pago) -->
		<Style x:Key="ChoicePill" TargetType="RadioButton">
			<Setter Property="Margin" Value="0,0,8,0" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="Bd" Height="36" CornerRadius="18" Padding="16,0"
                                Background="{StaticResource Paper}" BorderBrush="#E0E0E0" BorderThickness="1">
							<ContentPresenter x:Name="Cp" VerticalAlignment="Center" TextBlock.Foreground="#5C5C5C" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#B4B4B4" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource Ink}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
								<Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource Paper}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Tarjeta de habitación seleccionable -->
		<Style x:Key="RoomCard" TargetType="RadioButton">
			<Setter Property="Margin" Value="0,0,10,10" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="RadioButton">
						<Border x:Name="Bd" CornerRadius="16" Padding="16,14"
                                Background="{StaticResource Paper}" BorderBrush="#E8E8E8" BorderThickness="1">
							<ContentPresenter x:Name="Cp" TextBlock.Foreground="{StaticResource Text}" />
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#B4B4B4" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource Ink}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Ink}" />
								<Setter TargetName="Cp" Property="TextBlock.Foreground" Value="{StaticResource Paper}" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Fila de servicio con casilla -->
		<Style x:Key="ServiceRow" TargetType="CheckBox">
			<Setter Property="Margin" Value="0,0,0,8" />
			<Setter Property="Cursor" Value="Hand" />
			<Setter Property="Template">
				<Setter.Value>
					<ControlTemplate TargetType="CheckBox">
						<Border x:Name="Bd" CornerRadius="14" Padding="14,11"
                                Background="{StaticResource Paper}" BorderBrush="{StaticResource LineSoft}" BorderThickness="1">
							<Grid>
								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="19" />
									<ColumnDefinition Width="*" />
								</Grid.ColumnDefinitions>
								<Border x:Name="Box" Width="19" Height="19" CornerRadius="6"
                                        Background="{StaticResource Paper}" BorderBrush="#D4D4D4" BorderThickness="1">
									<Path x:Name="Tick" Data="M 3,7 L 6.5,10.5 L 13,3.5" Stroke="{StaticResource Paper}"
                                          StrokeThickness="2.2" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Visibility="Collapsed" HorizontalAlignment="Center" VerticalAlignment="Center" />
								</Border>
								<ContentPresenter Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" />
							</Grid>
						</Border>
						<ControlTemplate.Triggers>
							<Trigger Property="IsMouseOver" Value="True">
								<Setter TargetName="Bd" Property="BorderBrush" Value="#DCDCDC" />
							</Trigger>
							<Trigger Property="IsChecked" Value="True">
								<Setter TargetName="Bd" Property="Background" Value="{StaticResource Shell}" />
								<Setter TargetName="Bd" Property="BorderBrush" Value="#DCDCDC" />
								<Setter TargetName="Box" Property="Background" Value="{StaticResource Ink}" />
								<Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Ink}" />
								<Setter TargetName="Tick" Property="Visibility" Value="Visible" />
							</Trigger>
						</ControlTemplate.Triggers>
					</ControlTemplate>
				</Setter.Value>
			</Setter>
		</Style>

		<!-- Etiqueta negra (Combo / ID) -->
		<Style x:Key="TagDark" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource Ink}" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="9,3" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<Style x:Key="TagLight" TargetType="Border">
			<Setter Property="Background" Value="{StaticResource Paper}" />
			<Setter Property="CornerRadius" Value="10" />
			<Setter Property="Padding" Value="10,4" />
			<Setter Property="VerticalAlignment" Value="Center" />
		</Style>

		<!-- Filas del resumen -->
		<!-- Mensaje de validacion: oculto por defecto -->
		<Style x:Key="ErrorMsg" TargetType="TextBlock">
			<Setter Property="FontSize" Value="12" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{StaticResource Danger}" />
			<Setter Property="TextWrapping" Value="Wrap" />
			<Setter Property="Margin" Value="0,10,0,0" />
			<Setter Property="Visibility" Value="Collapsed" />
		</Style>

		<Style x:Key="SumLabel" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="Foreground" Value="{StaticResource DarkText}" />
			<Setter Property="TextTrimming" Value="CharacterEllipsis" />
		</Style>

		<Style x:Key="SumValue" TargetType="TextBlock">
			<Setter Property="FontSize" Value="13" />
			<Setter Property="FontWeight" Value="Medium" />
			<Setter Property="Foreground" Value="{StaticResource Paper}" />
			<Setter Property="HorizontalAlignment" Value="Right" />
		</Style>

	</Window.Resources>

	<!-- Velo del modal + caja -->
	<Border Background="#70121212" Padding="28">
		<Border Background="{StaticResource Shell}" CornerRadius="28" ClipToBounds="True">
			<Border.Effect>
				<DropShadowEffect BlurRadius="60" ShadowDepth="14" Opacity="0.34" Color="#000000" />
			</Border.Effect>

			<DockPanel LastChildFill="True">

				<!-- ================= Encabezado ================= -->
				<Border DockPanel.Dock="Top" Background="{StaticResource Paper}" Padding="28,22,28,20">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<StackPanel VerticalAlignment="Center">
							<TextBlock Text="RESERVAS" FontSize="11" FontWeight="SemiBold"
                                       Foreground="{StaticResource Faint}" />
							<TextBlock Text="Nueva reserva" FontSize="24" FontWeight="SemiBold"
                                       Foreground="{StaticResource Text}" Margin="0,3,0,0" />
						</StackPanel>
						<Button Grid.Column="1" x:Name="Btn_VerErrores" Content="Ver estados de error"
                                Style="{StaticResource PillOutline}" Height="34" Padding="15,0" FontSize="12.5"
                                Foreground="#5C5C5C" VerticalAlignment="Center" Margin="0,0,12,0" />
						<Button Grid.Column="2" x:Name="Btn_Cerrar" Width="38" Height="38" Cursor="Hand"
                                VerticalAlignment="Center" ToolTip="Cerrar">
							<Button.Template>
								<ControlTemplate TargetType="Button">
									<Border x:Name="Bd" Background="{StaticResource Shell}" CornerRadius="19">
										<Path Data="M 0,0 L 12,12 M 12,0 L 0,12" Stroke="#5C5C5C" StrokeThickness="1.9"
                                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
									</Border>
									<ControlTemplate.Triggers>
										<Trigger Property="IsMouseOver" Value="True">
											<Setter TargetName="Bd" Property="Background" Value="#E6E6E6" />
										</Trigger>
									</ControlTemplate.Triggers>
								</ControlTemplate>
							</Button.Template>
						</Button>
					</Grid>
				</Border>

				<!-- ================= Pie ================= -->
				<Border DockPanel.Dock="Bottom" Background="{StaticResource Paper}" Padding="28,16"
                        BorderBrush="{StaticResource LineSoft}" BorderThickness="0,1,0,0">
					<Grid>
						<Grid.ColumnDefinitions>
							<ColumnDefinition Width="*" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
							<ColumnDefinition Width="Auto" />
						</Grid.ColumnDefinitions>
						<TextBlock Text="Ctrl ↵ confirma · Esc sale y avisa si hay cambios sin guardar"
                                   FontSize="12" Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
						<Button Grid.Column="1" x:Name="Btn_Cancelar" Content="Cancelar" Style="{StaticResource PillGhost}" />
						<Button Grid.Column="2" x:Name="Btn_Borrador" Content="Guardar borrador"
                                Style="{StaticResource PillOutline}" Margin="12,0,0,0" />
						<Button Grid.Column="3" x:Name="Btn_Confirmar" Content="Confirmar reserva"
                                Style="{StaticResource PillPrimary}" Margin="12,0,0,0" />
					</Grid>
				</Border>

				<!-- ================= Cuerpo ================= -->
				<Grid Margin="28,16,28,22">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="*" MinWidth="520" />
						<ColumnDefinition Width="16" />
						<ColumnDefinition Width="336" />
					</Grid.ColumnDefinitions>

					<ScrollViewer Grid.Column="0" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
						<StackPanel>

							<!-- ================= 01 · Huésped ================= -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Huésped titular" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <controles:BuscadorHuesped x:Name="SelectorHuesped" />
                                    <Button x:Name="Btn_NuevoHuesped" Content="Nuevo huésped" Style="{StaticResource PillOutline}"
                                            HorizontalAlignment="Left" Margin="0,10,0,0" Padding="13,6" />
                                    <TextBlock x:Name="Er_Huesped" Style="{StaticResource ErrorMsg}" Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

<!-- ================= 02 · Fechas ================= -->
                            <Border Style="{StaticResource Card}">
                                <StackPanel>
                                    <TextBlock Text="Fechas y ocupación" FontWeight="SemiBold" Margin="0,0,0,12" />
                                    <controles:SelectorFechasEstadia x:Name="SelectorFechas" />
                                    <UniformGrid Columns="2" Margin="0,12,0,0">
                                        <StackPanel Margin="0,0,8,0">
                                            <TextBlock Text="Adultos" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="Tb_Adultos" Text="2" Style="{StaticResource RoundInput}" />
                                        </StackPanel>
                                        <StackPanel Margin="8,0,0,0">
                                            <TextBlock Text="Menores" Style="{StaticResource FieldLabel}" />
                                            <TextBox x:Name="Tb_Menores" Text="0" Style="{StaticResource RoundInput}" />
                                        </StackPanel>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

<!-- ================= 03 · Habitación ================= -->
							<Border Style="{StaticResource Card}">
								<StackPanel>
									<Grid Margin="0,0,0,6">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock Text="03" Style="{StaticResource SectionNum}" />
										<TextBlock Grid.Column="1" Text="Habitación" Style="{StaticResource SectionTitle}" />
										<TextBlock Grid.Column="2" Text="6 libres en el rango" Style="{StaticResource SectionAside}" />
									</Grid>
									<TextBlock Text="Solo se listan las libres en el rango elegido." FontSize="12.5"
                                               Foreground="{StaticResource Faint}" Margin="0,0,0,14" />

									<UniformGrid x:Name="Grid_Habitaciones" Rows="2" Columns="3">
									<!-- Las tarjetas se generan en Reservas.xaml.cs a partir de
									     sp_ListarHabitacionesDisponibles: dependen del rango de fechas,
									     asi que no pueden estar fijas en el XAML. Estilo: RoomCard. -->
								</UniformGrid>
									<TextBlock x:Name="Er_Habitacion" Style="{StaticResource ErrorMsg}" Margin="0,4,0,0"
                                               Text="Ninguna habitación está libre en ese rango. Cambiá las fechas." />
								</StackPanel>
							</Border>

							<!-- ================= 04 · Servicios (Nombre / Precio / EsCombo) ================= -->
							<Border Style="{StaticResource Card}">
								<StackPanel>
									<Grid Margin="0,0,0,12">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock Text="04" Style="{StaticResource SectionNum}" />
										<TextBlock Grid.Column="1" Text="Servicios y paquetes" Style="{StaticResource SectionTitle}" />
										<TextBlock Grid.Column="2" x:Name="Tx_ServiciosElegidos" Text="1 seleccionados" Style="{StaticResource SectionAside}" />
									</Grid>
									<StackPanel x:Name="Pn_Servicios">

										<CheckBox x:Name="Ch_Svc1" IsChecked="True" Style="{StaticResource ServiceRow}" Tag="Paquete Relax|42500|1|unica">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="118" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Paquete Relax" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
												<Border Grid.Column="1" Style="{StaticResource TagDark}" Margin="10,0">
													<TextBlock Text="Combo" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Paper}" />
												</Border>
												<TextBlock Grid.Column="2" Text="masaje + cena + spa · −15 %" FontSize="12"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
												<TextBlock Grid.Column="3" Text="$ 42.500,00" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
											</Grid>
										</CheckBox>

										<CheckBox x:Name="Ch_Svc2" Style="{StaticResource ServiceRow}" Tag="Media pensión|21000|1|unica">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="118" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Media pensión" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
												<Border Grid.Column="1" Style="{StaticResource TagDark}" Margin="10,0">
													<TextBlock Text="Combo" FontSize="11" FontWeight="Medium" Foreground="{StaticResource Paper}" />
												</Border>
												<TextBlock Grid.Column="2" Text="desayuno + cena" FontSize="12"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
												<TextBlock Grid.Column="3" Text="$ 21.000,00" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
											</Grid>
										</CheckBox>

										<CheckBox x:Name="Ch_Svc3" Style="{StaticResource ServiceRow}" Tag="Excursión al lago|18000|0|unica">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="118" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Excursión al lago" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
												<TextBlock Grid.Column="1" Text="una vez" FontSize="12"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
												<TextBlock Grid.Column="2" Text="$ 18.000,00" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
											</Grid>
										</CheckBox>

										<CheckBox x:Name="Ch_Svc4" Style="{StaticResource ServiceRow}" Tag="Desayuno en la habitación|6400|0|noche">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="118" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Desayuno en la habitación" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
												<TextBlock Grid.Column="1" Text="por noche" FontSize="12"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
												<TextBlock Grid.Column="2" Text="$ 6.400,00" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
											</Grid>
										</CheckBox>

										<CheckBox x:Name="Ch_Svc5" Style="{StaticResource ServiceRow}" Margin="0" Tag="Traslado al aeropuerto|12000|0|unica">
											<Grid>
												<Grid.ColumnDefinitions>
													<ColumnDefinition Width="*" />
													<ColumnDefinition Width="Auto" />
													<ColumnDefinition Width="118" />
												</Grid.ColumnDefinitions>
												<TextBlock Text="Traslado al aeropuerto" FontSize="13.5" FontWeight="Medium" VerticalAlignment="Center" />
												<TextBlock Grid.Column="1" Text="una vez" FontSize="12"
                                                       Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,12,0" />
												<TextBlock Grid.Column="2" Text="$ 12.000,00" FontSize="13" FontWeight="Medium"
                                                       HorizontalAlignment="Right" VerticalAlignment="Center" />
											</Grid>
										</CheckBox>
									</StackPanel>
								</StackPanel>
							</Border>

							<!-- ================= 05 · Pago y estado (EstadoReserva) ================= -->
							<Border Style="{StaticResource Card}">
								<StackPanel>
									<Grid Margin="0,0,0,14">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<TextBlock Text="05" Style="{StaticResource SectionNum}" />
										<TextBlock Grid.Column="1" Text="Pago y estado" Style="{StaticResource SectionTitle}" />
									</Grid>

									<StackPanel Orientation="Horizontal" Margin="0,0,0,16">
										<RadioButton x:Name="Rb_Senia" GroupName="Pago" IsChecked="True" Content="Seña" Style="{StaticResource ChoicePill}" />
										<RadioButton x:Name="Rb_PagoTotal" GroupName="Pago" Content="Pago total" Style="{StaticResource ChoicePill}" />
										<RadioButton x:Name="Rb_AlCheckIn" GroupName="Pago" Content="Al check-in" Style="{StaticResource ChoicePill}" />
									</StackPanel>

									<Grid>
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="140" />
											<ColumnDefinition Width="12" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="12" />
											<ColumnDefinition Width="*" />
										</Grid.ColumnDefinitions>
										<StackPanel>
											<TextBlock Text="Seña ($)" Style="{StaticResource FieldLabel}" />
											<TextBox x:Name="Tb_Senia" Text="30" Style="{StaticResource RoundInput}" />
										</StackPanel>
										<StackPanel Grid.Column="2">
											<TextBlock Text="Medio" Style="{StaticResource FieldLabel}" />
											<ComboBox x:Name="Cb_MedioPago" Style="{StaticResource RoundCombo}" SelectedIndex="0">
												<ComboBoxItem Content="Transferencia bancaria" />
												<ComboBoxItem Content="Tarjeta de crédito" />
												<ComboBoxItem Content="Tarjeta de débito" />
												<ComboBoxItem Content="Efectivo" />
											</ComboBox>
										</StackPanel>
										<StackPanel Grid.Column="4">
											<TextBlock Text="Estado de la reserva" Style="{StaticResource FieldLabel}" />
											<ComboBox x:Name="Cb_Estado" Style="{StaticResource RoundCombo}" SelectedIndex="1">
												<ComboBoxItem Content="Pendiente" Tag="Pendiente" />
												<ComboBoxItem Content="Confirmada" Tag="Confirmada" />
												<ComboBoxItem Content="Check-in realizado" Tag="CheckIn" />
												<ComboBoxItem Content="Finalizada" Tag="Finalizada" />
												<ComboBoxItem Content="Cancelada" Tag="Cancelada" />
											</ComboBox>
											<TextBlock Text="EstadoReserva" FontSize="11.5" Foreground="{StaticResource Faint}" Margin="0,6,0,0" />
										</StackPanel>
									</Grid>
									<TextBlock x:Name="Er_Senia" Style="{StaticResource ErrorMsg}"
                                               Text="Ingresá un importe válido." />
								</StackPanel>
							</Border>

							<!-- ================= 06 · Notas internas ================= -->
							<Border Style="{StaticResource Card}" Margin="0">
								<StackPanel>
									<Grid Margin="0,0,0,12">
										<Grid.ColumnDefinitions>
											<ColumnDefinition Width="Auto" />
											<ColumnDefinition Width="*" />
											<ColumnDefinition Width="Auto" />
										</Grid.ColumnDefinitions>
										<TextBlock Text="06" Style="{StaticResource SectionNum}" />
										<TextBlock Grid.Column="1" Text="Notas internas" Style="{StaticResource SectionTitle}" />
										<TextBlock Grid.Column="2" Text="No se muestran al huésped" FontSize="12"
                                                   Foreground="{StaticResource Faint}" VerticalAlignment="Center" />
									</Grid>
									<TextBox x:Name="Tb_Notas" Style="{StaticResource NotesInput}"
                                             Tag="Cuna en la habitación, llegada tardía, preferencias del huésped…" />
								</StackPanel>
							</Border>

						</StackPanel>
					</ScrollViewer>

					<!-- ================= Resumen (Total) ================= -->
					<controles:ResumenReserva x:Name="Resumen" Grid.Column="2" VerticalAlignment="Top" />
				</Grid>
			</DockPanel>
		</Border>
	</Border>
</Window>
