<?xml version="1.0" encoding="utf-8" ?>
<configuration>
	<appSettings file="secrets.config.template.xml" />
	<connectionStrings>
		<add name="StayEasyDB"
             connectionString="Data Source=(localdb)\MSSQLLocalDB;Initial Catalog=StayEasyDB;Integrated Security=True;TrustServerCertificate=True;"
             providerName="Microsoft.Data.SqlClient" />
	</connectionStrings>
</configuration>