<Window x:Class="StayEasy.UI.ResetPassword"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayEasy · Recuperar contraseña"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="/Assets/stayeasy-marca-claro.ico"
        WindowStyle="None"
        AllowsTransparency="True"
        ResizeMode="CanResizeWithGrip"
        Background="Transparent">

    <Window.Resources>

        <!-- ========== Paleta ========== -->
        <SolidColorBrush x:Key="Login.Brush.Bg"          Color="#E6E6E6" />
        <SolidColorBrush x:Key="Login.Brush.Glass"       Color="#E6E6E6" />
        <SolidColorBrush x:Key="Login.Brush.GlassBorder" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.Card"        Color="#FFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.Dark"        Color="#1C1C1C" />
        <SolidColorBrush x:Key="Login.Brush.DarkTile"    Color="#262626" />
        <SolidColorBrush x:Key="Login.Brush.DarkBorder"  Color="#333333" />
        <SolidColorBrush x:Key="Login.Brush.OnDark"      Color="#FFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.OnDarkMuted" Color="#A8A8A8" />
        <SolidColorBrush x:Key="Login.Brush.Text"        Color="#1A1A1A" />
        <SolidColorBrush x:Key="Login.Brush.TextMuted"   Color="#8A8A8A" />
        <SolidColorBrush x:Key="Login.Brush.Label"       Color="#5C5C5C" />
        <SolidColorBrush x:Key="Login.Brush.Field"       Color="#F6F6F6" />
        <SolidColorBrush x:Key="Login.Brush.FieldBorder" Color="#E4E4E4" />
        <SolidColorBrush x:Key="Login.Brush.Hairline"    Color="#ECECEC" />
        <SolidColorBrush x:Key="Login.Brush.Hover"       Color="#000000" />
        <SolidColorBrush x:Key="Login.Brush.Pressed"     Color="#3A3A3A" />

        <!-- ========== Tipografía ========== -->
        <Style x:Key="Login.Text.Display" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="48" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDark}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Login.Text.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
        </Style>

        <Style x:Key="Login.Text.Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Login.Text.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Label}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Login.Text.Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDark}" />
        </Style>

        <Style x:Key="Login.Text.MetricCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDarkMuted}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- ========== Campos de texto ========== -->
        <Style x:Key="Login.FieldShell" TargetType="Border">
            <Setter Property="Height" Value="50" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource Login.Brush.Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Login.Brush.FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Login.Brush.Dark}" />
                    <Setter Property="Background" Value="{StaticResource Login.Brush.Card}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Login.FieldInput" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Login.Brush.Text}" />
        </Style>

        <Style x:Key="Login.FieldPassword" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Login.Brush.Text}" />
        </Style>

        <Style x:Key="Login.Placeholder" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#A3A3A3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ========== Botón primario ========== -->
        <Style x:Key="Login.Button.Primary" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDark}" />
            <Setter Property="Background" Value="{StaticResource Login.Brush.Dark}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Login.Brush.Pressed}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Botón secundario ========== -->
        <Style x:Key="Login.Button.Secondary" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
            <Setter Property="Background" Value="{StaticResource Login.Brush.Card}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Login.Brush.FieldBorder}" BorderThickness="1"
                                CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Field}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4D4D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Hairline}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Botón de enlace ========== -->
        <Style x:Key="Login.Button.Link" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Label}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Login.Brush.Dark}" />
                                <Setter TargetName="Tx" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Botón del ojo ========== -->
        <Style x:Key="Login.Button.Eye" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <Path x:Name="Ic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Fill="Transparent"
                                  Data="M2,12 C2,12 5.6,5.5 12,5.5 C18.4,5.5 22,12 22,12 C22,12 18.4,18.5 12,18.5 C5.6,18.5 2,12 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z"
                                  Stretch="Uniform" Width="18" Height="18" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEEEEE" />
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Login.Brush.Dark}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Login.Brush.Dark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Checkbox ========== -->
        <Style x:Key="Login.CheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#3D3D3D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6"
                                    Background="{StaticResource Login.Brush.Card}"
                                    BorderBrush="#CFCFCF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                      Stroke="{StaticResource Login.Brush.OnDark}" StrokeThickness="2.5"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Data="M4,12.5 L9.5,18 L20,6" Stretch="Uniform"
                                      Width="11" Height="11"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Login.Brush.Dark}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Login.Brush.Dark}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Login.Brush.Label}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Tarjeta métrica ========== -->
        <Style x:Key="Login.MetricTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Login.Brush.DarkTile}" />
            <Setter Property="BorderBrush" Value="{StaticResource Login.Brush.DarkBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

    </Window.Resources>

    <!-- ========== Fondo ========== -->
    <Grid x:Name="MainGrid" Background="Transparent" ClipToBounds="True">



        <!-- ================= Contenedor "vidrio" con fondo gris ================= -->
        <Border MaxWidth="1120" Margin="48"
                Background="{StaticResource Login.Brush.Glass}"
                BorderBrush="#D0D0D0" BorderThickness="1"
                CornerRadius="32" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="60" ShadowDepth="14" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="113*"/>
                    <RowDefinition Height="104*"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>


                <!-- ========== Formulario ========== -->
                <Border Grid.Column="1" Background="{StaticResource Login.Brush.Card}"
                        CornerRadius="24" Padding="44,48" Grid.RowSpan="2" Grid.ColumnSpan="2" Margin="10,0,10,0">
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="¡Recupera tu contraseña!" Style="{StaticResource Login.Text.Heading}" />
                        <TextBlock Text="Ingresá tu mail para recuperar la contraseña."
                                   Style="{StaticResource Login.Text.Body}" Margin="0,8,0,0" />

                        <!-- Email -->
                        <TextBlock x:Name="lbl_Email" Text="Email" Style="{StaticResource Login.Text.Label}" Margin="0,26,0,8" />
                        <Border Style="{StaticResource Login.FieldShell}">
                            <Grid>
                                <TextBlock x:Name="Ph_Usuario" Text="Ingresá tu Mail"
                                           Style="{StaticResource Login.Placeholder}" />
                                <TextBox x:Name="Txt_Usuario" Style="{StaticResource Login.FieldInput}"
                                         TabIndex="1" />
                            </Grid>
                        </Border>

                        <!-- Token -->
                        <TextBlock x:Name="lbl_Token" Text="Token" Style="{StaticResource Login.Text.Label}" Margin="0,26,0,8" Visibility="Collapsed" />
                        <Border Style="{StaticResource Login.FieldShell}" Visibility="Collapsed">
                            <Grid>
                                <TextBlock x:Name="Ph_Token" Text="Ingresá tu Token"
                                   Style="{StaticResource Login.Placeholder}" />
                                <TextBox x:Name="Txt_Token" Style="{StaticResource Login.FieldInput}"
                                 TabIndex="1" />
                            </Grid>
                        </Border>


                        <!-- Mensaje de error -->
                        <Border x:Name="Pnl_Error" Margin="0,16,0,0" Padding="14,10"
                                CornerRadius="12" Background="#F4F4F4" BorderBrush="#E0E0E0"
                                BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="Lbl_Error" Text="Usuario o contraseña incorrectos."
                                       FontSize="13" Foreground="{StaticResource Login.Brush.Text}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Acción primaria -->
                        <Button x:Name="Btn_SolicitarToken" Content="Solicitar Token"
                                Style="{StaticResource Login.Button.Primary}"
                                Margin="0,26,0,0" IsDefault="True" TabIndex="5" Click="Btn_SolicitarToken_Click" />
                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>