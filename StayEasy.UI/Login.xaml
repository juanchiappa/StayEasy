<Window x:Class="StayEasy.UI.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayEasy · Iniciar sesión"
        Width="1280" Height="800"
        MinWidth="1024" MinHeight="700"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="/Assets/stayeasy-marca-claro.ico"
        Background="#E6E6E6">

    <!-- Login (mockup monocromo). Paleta local: esta pantalla es previa al
         shell y no consume StayEasy.Tokens a propósito, para que el contraste
         alto del panel oscuro no dependa del tema de la app. -->

    <Window.Resources>

        <!-- ========== Paleta ========== -->
        <SolidColorBrush x:Key="Login.Brush.Bg"          Color="#E6E6E6" />
        <SolidColorBrush x:Key="Login.Brush.Glass"       Color="#6BFFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.GlassBorder" Color="#B8FFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.Card"        Color="#FFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.Dark"        Color="#1C1C1C" />
        <SolidColorBrush x:Key="Login.Brush.DarkTile"    Color="#262626" />
        <SolidColorBrush x:Key="Login.Brush.DarkBorder"  Color="#333333" />
        <SolidColorBrush x:Key="Login.Brush.OnDark"      Color="#FFFFFF" />
        <SolidColorBrush x:Key="Login.Brush.OnDarkMuted" Color="#A8A8A8" />
        <SolidColorBrush x:Key="Login.Brush.Text"        Color="#1A1A1A" />
        <SolidColorBrush x:Key="Login.Brush.TextMuted"   Color="#8A8A8A" />
        <SolidColorBrush x:Key="Login.Brush.Label"       Color="#5C5C5C" />
        <SolidColorBrush x:Key="Login.Brush.Field"       Color="#F6F6F6" />
        <SolidColorBrush x:Key="Login.Brush.FieldBorder" Color="#E4E4E4" />
        <SolidColorBrush x:Key="Login.Brush.Hairline"    Color="#ECECEC" />
        <SolidColorBrush x:Key="Login.Brush.Hover"       Color="#000000" />
        <SolidColorBrush x:Key="Login.Brush.Pressed"     Color="#3A3A3A" />

        <!-- ========== Tipografía ========== -->
        <Style x:Key="Login.Text.Display" TargetType="TextBlock">
            <Setter Property="FontSize" Value="44" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="LineHeight" Value="48" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDark}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Login.Text.Heading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="30" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
        </Style>

        <Style x:Key="Login.Text.Body" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.TextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="Login.Text.Label" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Label}" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>

        <Style x:Key="Login.Text.Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="26" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDark}" />
        </Style>

        <Style x:Key="Login.Text.MetricCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDarkMuted}" />
            <Setter Property="Margin" Value="0,4,0,0" />
        </Style>

        <!-- ========== Campos de texto ==========
             El TextBox real no tiene borde: el Border exterior dibuja el
             radio y cambia de color en foco (via IsKeyboardFocusWithin). -->
        <Style x:Key="Login.FieldShell" TargetType="Border">
            <Setter Property="Height" Value="50" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Background" Value="{StaticResource Login.Brush.Field}" />
            <Setter Property="BorderBrush" Value="{StaticResource Login.Brush.FieldBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,0" />
            <Style.Triggers>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource Login.Brush.Dark}" />
                    <Setter Property="Background" Value="{StaticResource Login.Brush.Card}" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="Login.FieldInput" TargetType="TextBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Login.Brush.Text}" />
        </Style>

        <Style x:Key="Login.FieldPassword" TargetType="PasswordBox">
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="CaretBrush" Value="{StaticResource Login.Brush.Text}" />
        </Style>

        <!-- Placeholder: TextBlock encima del campo, oculto cuando hay texto.
             El code-behind alterna Visibility en TextChanged / PasswordChanged. -->
        <Style x:Key="Login.Placeholder" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="#A3A3A3" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="IsHitTestVisible" Value="False" />
        </Style>

        <!-- ========== Botón primario (pill negro) ========== -->
        <Style x:Key="Login.Button.Primary" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.OnDark}" />
            <Setter Property="Background" Value="{StaticResource Login.Brush.Dark}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Hover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Pressed}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Login.Brush.Pressed}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="2" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Botón secundario (pill blanco, borde) ========== -->
        <Style x:Key="Login.Button.Secondary" TargetType="Button">
            <Setter Property="Height" Value="52" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Text}" />
            <Setter Property="Background" Value="{StaticResource Login.Brush.Card}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{StaticResource Login.Brush.FieldBorder}" BorderThickness="1"
                                CornerRadius="26">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Field}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#D4D4D4" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Login.Brush.Hairline}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Botón de enlace (texto) ========== -->
        <Style x:Key="Login.Button.Link" TargetType="Button">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.Label}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}"
                                   FontWeight="{TemplateBinding FontWeight}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Login.Brush.Dark}" />
                                <Setter TargetName="Tx" Property="TextDecorations" Value="Underline" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Botón del ojo (mostrar contraseña) ========== -->
        <Style x:Key="Login.Button.Eye" TargetType="ToggleButton">
            <Setter Property="Width" Value="34" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{StaticResource Login.Brush.TextMuted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="10">
                            <Path x:Name="Ic" HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Stroke="{TemplateBinding Foreground}" StrokeThickness="1.5" Fill="Transparent"
                                  Data="M2,12 C2,12 5.6,5.5 12,5.5 C18.4,5.5 22,12 22,12 C22,12 18.4,18.5 12,18.5 C5.6,18.5 2,12 2,12 Z M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z"
                                  Stretch="Uniform" Width="18" Height="18" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#EEEEEE" />
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Login.Brush.Dark}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Login.Brush.Dark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Checkbox cuadrado con radio ========== -->
        <Style x:Key="Login.CheckBox" TargetType="CheckBox">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="#3D3D3D" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <StackPanel Orientation="Horizontal">
                            <Border x:Name="Box" Width="20" Height="20" CornerRadius="6"
                                    Background="{StaticResource Login.Brush.Card}"
                                    BorderBrush="#CFCFCF" BorderThickness="1"
                                    VerticalAlignment="Center">
                                <Path x:Name="Tick" Visibility="Collapsed"
                                      Stroke="{StaticResource Login.Brush.OnDark}" StrokeThickness="2.5"
                                      StrokeEndLineCap="Round" StrokeStartLineCap="Round"
                                      Data="M4,12.5 L9.5,18 L20,6" Stretch="Uniform"
                                      Width="11" Height="11"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <ContentPresenter Margin="10,0,0,0" VerticalAlignment="Center" />
                        </StackPanel>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Box" Property="Background" Value="{StaticResource Login.Brush.Dark}" />
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Login.Brush.Dark}" />
                                <Setter TargetName="Tick" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Box" Property="BorderBrush" Value="{StaticResource Login.Brush.Label}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ========== Tarjeta métrica del panel oscuro ========== -->
        <Style x:Key="Login.MetricTile" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Login.Brush.DarkTile}" />
            <Setter Property="BorderBrush" Value="{StaticResource Login.Brush.DarkBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="18,16" />
        </Style>

    </Window.Resources>

    <!-- ========== Fondo ========== -->
    <Grid Background="{StaticResource Login.Brush.Bg}" ClipToBounds="True">

        <!-- Blobs difusos del fondo (equivalentes a los radiales del mockup) -->
        <Ellipse Width="900" Height="900" Margin="-180,-280,0,0"
                 HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.35,0.35" GradientOrigin="0.35,0.35" RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="760" Height="760" Margin="0,0,-140,-260"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush Center="0.55,0.45" GradientOrigin="0.55,0.45" RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="#FFCFCFCF" Offset="0" />
                    <GradientStop Color="#00CFCFCF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <Ellipse Width="620" Height="620" Margin="240,0,0,-180"
                 HorizontalAlignment="Left" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Color="#FFF6F6F6" Offset="0" />
                    <GradientStop Color="#00F6F6F6" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ================= Contenedor "vidrio" ================= -->
        <Border MaxWidth="1120" Margin="48"
                Background="{StaticResource Login.Brush.Glass}"
                BorderBrush="{StaticResource Login.Brush.GlassBorder}" BorderThickness="1"
                CornerRadius="32" Padding="20"
                HorizontalAlignment="Center" VerticalAlignment="Center">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.10" BlurRadius="60" ShadowDepth="14" Direction="270" />
            </Border.Effect>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- ========== Panel oscuro: marca, claim y métricas ========== -->
                <Border Grid.Column="0" Background="{StaticResource Login.Brush.Dark}"
                        CornerRadius="24" Padding="40" MinHeight="560">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Grid.Row="0" Orientation="Horizontal">
                            <Border Width="34" Height="34" CornerRadius="10"
                                    Background="{StaticResource Login.Brush.OnDark}">
                                <TextBlock Text="S" FontSize="15" FontWeight="Bold"
                                           Foreground="{StaticResource Login.Brush.Dark}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                            </Border>
                            <TextBlock Text="StayEasy" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold"
                                       Foreground="{StaticResource Login.Brush.OnDark}" VerticalAlignment="Center" />
                        </StackPanel>

                        <StackPanel Grid.Row="1" VerticalAlignment="Center" Margin="0,40">
                            <TextBlock Style="{StaticResource Login.Text.Display}">
                                Gestioná tu estadía,<LineBreak />sin complicaciones.
                            </TextBlock>
                            <TextBlock Text="Reservas, check-in y check-out en un solo lugar."
                                       Margin="0,18,0,0" MaxWidth="360" FontSize="16" LineHeight="24"
                                       Foreground="{StaticResource Login.Brush.OnDarkMuted}"
                                       TextWrapping="Wrap" />
                        </StackPanel>

                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Login.MetricTile}">
                                <StackPanel>
                                    <TextBlock x:Name="Lbl_Habitaciones" Text="28" Style="{StaticResource Login.Text.Metric}" />
                                    <TextBlock Text="Habitaciones" Style="{StaticResource Login.Text.MetricCaption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="2" Style="{StaticResource Login.MetricTile}">
                                <StackPanel>
                                    <TextBlock x:Name="Lbl_CheckInHoy" Text="14" Style="{StaticResource Login.Text.Metric}" />
                                    <TextBlock Text="Check-in hoy" Style="{StaticResource Login.Text.MetricCaption}" />
                                </StackPanel>
                            </Border>
                            <Border Grid.Column="4" Style="{StaticResource Login.MetricTile}">
                                <StackPanel>
                                    <TextBlock x:Name="Lbl_Salidas" Text="11" Style="{StaticResource Login.Text.Metric}" />
                                    <TextBlock Text="Salidas" Style="{StaticResource Login.Text.MetricCaption}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!-- ========== Formulario ========== -->
                <Border Grid.Column="2" Background="{StaticResource Login.Brush.Card}"
        CornerRadius="24" Padding="44,48">
                    <StackPanel VerticalAlignment="Center">

                        <TextBlock Text="¡Bienvenido de nuevo!" Style="{StaticResource Login.Text.Heading}" />
                        <TextBlock Text="Ingresá para gestionar tus reservas."
                                   Style="{StaticResource Login.Text.Body}" Margin="0,8,0,0" />

                        <!-- Usuario -->
                        <TextBlock Text="Usuario" Style="{StaticResource Login.Text.Label}" Margin="0,26,0,8" />
                        <Border Style="{StaticResource Login.FieldShell}">
                            <Grid>
                                <TextBlock x:Name="Ph_Usuario" Text="Ingresá tu usuario"
                                           Style="{StaticResource Login.Placeholder}" />
                                <TextBox x:Name="Txt_Usuario" Style="{StaticResource Login.FieldInput}"
                                         TabIndex="1" />
                            </Grid>
                        </Border>

                        <!-- Contraseña -->
                        <TextBlock Text="Contraseña" Style="{StaticResource Login.Text.Label}" Margin="0,16,0,8" />
                        <Border Style="{StaticResource Login.FieldShell}" Padding="16,0,8,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Grid Grid.Column="0">
                                    <TextBlock x:Name="Ph_Password" Text="Ingresá tu contraseña"
                                               Style="{StaticResource Login.Placeholder}" />
                                    <!-- Contraseña oculta -->
                                    <PasswordBox x:Name="Pwd_Password" Style="{StaticResource Login.FieldPassword}"
                                                 TabIndex="2" />
                                    <!-- Contraseña visible: el code-behind alterna Visibility
                                         entre Pwd_Password y Txt_PasswordVisible y sincroniza el valor. -->
                                    <TextBox x:Name="Txt_PasswordVisible" Style="{StaticResource Login.FieldInput}"
                                             Visibility="Collapsed" />
                                </Grid>

                                <ToggleButton x:Name="Btn_VerPassword" Grid.Column="1"
                                              Style="{StaticResource Login.Button.Eye}"
                                              ToolTip="Mostrar contraseña"
                                              VerticalAlignment="Center" TabIndex="3" />
                            </Grid>
                        </Border>

                        <!-- Recordarme / olvidé la contraseña -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="Chk_Recordarme" Grid.Column="0" Content="Recordarme"
                                      Style="{StaticResource Login.CheckBox}" IsChecked="True"
                                      VerticalAlignment="Center" TabIndex="4" />
                            <Button x:Name="Btn_OlvidePassword" Grid.Column="1"
                                    Content="¿Olvidaste tu contraseña?"
                                    Style="{StaticResource Login.Button.Link}"
                                    VerticalAlignment="Center" TabIndex="7" />
                        </Grid>

                        <!-- Mensaje de error de credenciales (oculto por defecto) -->
                        <Border x:Name="Pnl_Error" Margin="0,16,0,0" Padding="14,10"
                                CornerRadius="12" Background="#F4F4F4" BorderBrush="#E0E0E0"
                                BorderThickness="1" Visibility="Collapsed">
                            <TextBlock x:Name="Lbl_Error" Text="Usuario o contraseña incorrectos."
                                       FontSize="13" Foreground="{StaticResource Login.Brush.Text}"
                                       TextWrapping="Wrap" />
                        </Border>

                        <!-- Acción primaria -->
                        <Button x:Name="Btn_IniciarSesion" Content="Iniciar sesión"
                        Style="{StaticResource Login.Button.Primary}"
                        Margin="0,26,0,0" IsDefault="True" TabIndex="5" />

                        <!-- Separador "o continuá con" -->
                        <Grid Margin="0,14,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Grid.Column="0" Height="1" Background="{StaticResource Login.Brush.Hairline}"
                                    VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="o continuá con" Margin="12,0" FontSize="12"
                                       Foreground="#A3A3A3" VerticalAlignment="Center" />
                            <Border Grid.Column="2" Height="1" Background="{StaticResource Login.Brush.Hairline}"
                                    VerticalAlignment="Center" />
                        </Grid>

                        <!-- Acción secundaria -->
                        <Button x:Name="Btn_Google" Style="{StaticResource Login.Button.Secondary}"
                                Margin="0,14,0,0" TabIndex="6">
                            <StackPanel Orientation="Horizontal">
                                <Path Width="18" Height="18" Stretch="Uniform" Opacity="0.85"
                                      Fill="{StaticResource Login.Brush.Text}"
                                      VerticalAlignment="Center"
                                      Data="M12,11 L12,13.6 L18.1,13.6 C17.85,15.2 16.25,18.3 12,18.3 A6.3,6.3 0 0 1 12,5.7 C13.6,5.7 14.7,6.4 15.3,7 L17.5,4.9 A9,9 0 1 0 12,21 C17.2,21 20.6,17.35 20.6,12.2 C20.6,11.6 20.54,11.15 20.45,11 Z" />
                                <TextBlock Text="Continuar con Google" Margin="10,0,0,0" FontSize="15"
                                           VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>

                        <!-- Registro -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,20,0,0">
                            <TextBlock Text="¿No tenés cuenta?" FontSize="14"
                                       Foreground="{StaticResource Login.Brush.TextMuted}"
                                       VerticalAlignment="Center" />
                            <Button x:Name="Btn_Registrarse" Content="Registrate acá" Margin="6,0,0,0"
                                    FontWeight="Medium" Foreground="{StaticResource Login.Brush.Dark}"
                                    Style="{StaticResource Login.Button.Link}"
                                    VerticalAlignment="Center" TabIndex="8" />
                        </StackPanel>

                    </StackPanel>
                </Border>

            </Grid>
        </Border>
    </Grid>
</Window>
