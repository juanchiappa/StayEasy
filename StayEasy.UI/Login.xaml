<ui:FluentWindow x:Class="StayEasy.UI.Login"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        Title="StayEasy - Ingreso" Height="650" Width="1000"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" ExtendsContentIntoTitleBar="True"
        Background="White">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"/>
            <ColumnDefinition Width="1*"/>
        </Grid.ColumnDefinitions>

        <!-- Panel izquierdo: imagen + branding -->
        <Border Grid.Column="0" Background="#1A2238" Margin="10" CornerRadius="16">
            <Grid>
                <Image x:Name="Img_Portada" Source="/Assets/Hotel.jpg" Stretch="UniformToFill" Opacity="0.6"/>
                <!-- Cuando tengas la foto: Source="/Assets/hotel_cover.jpg" -->

                <DockPanel Margin="30">
                    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                        <TextBlock Text="🏨" FontSize="20" Margin="0,0,8,0"/>
                        <TextBlock Text="StayEasy" FontSize="18" FontWeight="Bold" Foreground="White"/>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Margin="0,0,0,20">
                        <TextBlock Text="Gestioná tu estadía," FontSize="30" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock Text="sin complicaciones." FontSize="30" FontWeight="Bold" Foreground="White" TextWrapping="Wrap"/>
                        <TextBlock Text="Reservas, check-in y check-out en un solo lugar." FontSize="13" Foreground="#B0B8C9" Margin="0,10,0,0" TextWrapping="Wrap"/>
                    </StackPanel>
                </DockPanel>
            </Grid>
        </Border>

        <!-- Panel derecho: formulario -->
        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="50,0">
            <TextBlock Text="¡Bienvenido de nuevo!" FontSize="26" FontWeight="Bold"/>
            <TextBlock Text="Ingresá para gestionar tus reservas." FontSize="13" Foreground="Gray" Margin="0,4,0,25"/>

            <TextBlock Text="Usuario" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ui:TextBox x:Name="Txt_Usuario" PlaceholderText="Ingresá tu usuario" Margin="0,0,0,15"/>

            <TextBlock Text="Contraseña" FontSize="12" FontWeight="SemiBold" Margin="0,0,0,5"/>
            <ui:PasswordBox x:Name="Txt_Password" PlaceholderText="Ingresá tu contraseña" Margin="0,0,0,10"/>

            <Grid Margin="0,0,0,20">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <CheckBox x:Name="Chk_Recordarme" Content="Recordarme" Grid.Column="0"/>
                <ui:HyperlinkButton x:Name="Btn_OlvideContraseña" Content="¿Olvidaste tu contraseña?"
                                    Grid.Column="1" FontSize="12"/>
            </Grid>

            <ui:Button x:Name="Btn_IniciarSesion" Content="Iniciar sesión"
                       Appearance="Primary" Height="42" Click="Btn_IniciarSesion_Click" Margin="0,0,0,15"/>

            <Grid Margin="0,0,0,15">
                <Separator VerticalAlignment="Center"/>
                <TextBlock Text="  o continuá con  " Background="White" HorizontalAlignment="Center" FontSize="11" Foreground="Gray"/>
            </Grid>

            <ui:Button x:Name="Btn_ContinuarGoogle" Content="Continuar con Google"
                       Appearance="Secondary" Height="40" Margin="0,0,0,15" Width="368"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                <TextBlock Text="¿No tenés cuenta? " FontSize="12" Foreground="Gray"/>
                <ui:HyperlinkButton x:Name="Btn_Registrarse" Content="Registrate acá"
                                    Click="Btn_Registrarse_Click" FontSize="12"/>
            </StackPanel>
        </StackPanel>
    </Grid>
</ui:FluentWindow>