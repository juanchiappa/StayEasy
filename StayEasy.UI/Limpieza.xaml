<Window x:Class="StayEasy.UI.Dashboard"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="StayEasy"
        Width="1440" Height="900"
        MinWidth="1180" MinHeight="760"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        Icon="/Assets/stayeasy-marca-claro.ico"
        Background="#E6E6E6">

    <!-- Dashboard (shell + pantalla de inicio), maqueta monocroma.
         Paleta local en Window.Resources, igual que Login.xaml: el shell no
         consume StayEasy.Tokens para que el contraste del panel oscuro no
         dependa del tema de la app. -->

    <Window.Resources>

        <!-- ================= Paleta ================= -->
        <SolidColorBrush x:Key="Db.Bg"          Color="#E6E6E6" />
        <SolidColorBrush x:Key="Db.Card"        Color="#FFFFFF" />
        <SolidColorBrush x:Key="Db.Dark"        Color="#1C1C1C" />
        <SolidColorBrush x:Key="Db.DarkHover"   Color="#000000" />
        <SolidColorBrush x:Key="Db.DarkTile"    Color="#262626" />
        <SolidColorBrush x:Key="Db.DarkBorder"  Color="#333333" />
        <SolidColorBrush x:Key="Db.DarkTrack"   Color="#3A3A3A" />
        <SolidColorBrush x:Key="Db.OnDark"      Color="#FFFFFF" />
        <SolidColorBrush x:Key="Db.OnDarkMuted" Color="#9A9A9A" />
        <SolidColorBrush x:Key="Db.Text"        Color="#1A1A1A" />
        <SolidColorBrush x:Key="Db.TextBody"    Color="#3D3D3D" />
        <SolidColorBrush x:Key="Db.TextMuted"   Color="#8A8A8A" />
        <SolidColorBrush x:Key="Db.TextFaint"   Color="#A3A3A3" />
        <SolidColorBrush x:Key="Db.Hairline"    Color="#F2F2F2" />
        <SolidColorBrush x:Key="Db.RowLine"     Color="#F7F7F7" />
        <SolidColorBrush x:Key="Db.Sunken"      Color="#F4F4F4" />
        <SolidColorBrush x:Key="Db.Hover"       Color="#F2F2F2" />
        <SolidColorBrush x:Key="Db.Track"       Color="#F0F0F0" />
        <SolidColorBrush x:Key="Db.Border"      Color="#E0E0E0" />
        <SolidColorBrush x:Key="Db.Mid"         Color="#8F8F8F" />

        <!-- ================= Tipografía ================= -->
        <Style x:Key="Db.PageTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Db.Text}" />
        </Style>
        <Style x:Key="Db.PageSubtitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Db.TextMuted}" />
            <Setter Property="Margin" Value="0,4,0,0" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>
        <Style x:Key="Db.CardTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Db.Text}" />
        </Style>
        <Style x:Key="Db.CardCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource Db.TextFaint}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>
        <Style x:Key="Db.GroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#A8A8A8" />
            <Setter Property="Margin" Value="10,0,10,8" />
            <!-- El mockup usa mayúsculas + tracking; en WPF el texto ya va escrito
                 en mayúsculas y el tracking se aproxima con este espaciado. -->
        </Style>
        <Style x:Key="Db.Metric" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{StaticResource Db.OnDark}" />
        </Style>
        <Style x:Key="Db.MetricCaption" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{StaticResource Db.OnDarkMuted}" />
            <Setter Property="Margin" Value="0,3,0,0" />
        </Style>

        <!-- ================= Tarjetas ================= -->
        <Style x:Key="Db.Card.Light" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Db.Card}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="26,24" />
        </Style>
        <Style x:Key="Db.Card.Dark" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Db.Dark}" />
            <Setter Property="CornerRadius" Value="24" />
            <Setter Property="Padding" Value="28,26" />
        </Style>
        <Style x:Key="Db.Tile.Dark" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Db.DarkTile}" />
            <Setter Property="BorderBrush" Value="{StaticResource Db.DarkBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Padding" Value="16,14" />
        </Style>

        <!-- ================= Navegación ================= -->
        <!-- Un RadioButton por pestaña, agrupados por GroupName: el grupo da
             la exclusividad y IsChecked el estado activo. El code-behind
             escucha Checked y cambia el contenido de Host_Contenido. -->
        <Style x:Key="Db.NavItem" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Nav" />
            <Setter Property="Height" Value="38" />
            <Setter Property="FontSize" Value="13.5" />
            <Setter Property="Foreground" Value="{StaticResource Db.TextBody}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="12" Padding="10,0">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="18" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- El icono se pasa como Tag (Geometry) desde cada item -->
                                <Path Grid.Column="0" x:Name="Ic" Width="17" Height="17" Stretch="Uniform"
                                      Data="{TemplateBinding Tag}"
                                      Stroke="{TemplateBinding Foreground}" StrokeThickness="1.6"
                                      StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      Fill="Transparent"
                                      HorizontalAlignment="Center" VerticalAlignment="Center" />

                                <TextBlock Grid.Column="1" x:Name="Tx" Text="{TemplateBinding Content}"
                                           Margin="11,0,0,0" VerticalAlignment="Center"
                                           Foreground="{TemplateBinding Foreground}"
                                           FontSize="{TemplateBinding FontSize}"
                                           TextTrimming="CharacterEllipsis" />

                                <!-- La columna 2 queda reservada para el badge de pendientes,
                                     que se superpone desde afuera (ver Nav_Reservas). -->
                                <Border Grid.Column="2" MinWidth="26" Background="Transparent" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Db.Hover}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Db.Dark}" />
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Db.OnDark}" />
                                <Setter TargetName="Tx" Property="FontWeight" Value="Medium" />
                                <Setter TargetName="Ic" Property="Stroke" Value="{StaticResource Db.OnDark}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource Db.Dark}" />
                                <Setter TargetName="Bd" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Badge suelto, para los items que llevan contador -->
        <Style x:Key="Db.NavBadge" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Db.Track}" />
            <Setter Property="CornerRadius" Value="9" />
            <Setter Property="Padding" Value="7,1" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="Db.NavBadgeText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5C5C5C" />
        </Style>

        <!-- ================= Botones ================= -->
        <Style x:Key="Db.Button.Pill" TargetType="Button">
            <Setter Property="Height" Value="42" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Db.OnDark}" />
            <Setter Property="Background" Value="{StaticResource Db.Dark}" />
            <Setter Property="Padding" Value="20,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="21"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Db.DarkHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#3A3A3A" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Db.Button.Round" TargetType="Button">
            <Setter Property="Width" Value="42" />
            <Setter Property="Height" Value="42" />
            <Setter Property="Background" Value="{StaticResource Db.Card}" />
            <Setter Property="Foreground" Value="{StaticResource Db.Dark}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="21">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#F6F6F6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Acción de fila: primaria (negra) y secundaria (borde) -->
        <Style x:Key="Db.Button.RowPrimary" TargetType="Button">
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="{StaticResource Db.OnDark}" />
            <Setter Property="Background" Value="{StaticResource Db.Dark}" />
            <Setter Property="Padding" Value="15,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Db.DarkHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Db.Button.RowGhost" TargetType="Button" BasedOn="{StaticResource Db.Button.RowPrimary}">
            <Setter Property="Foreground" Value="{StaticResource Db.Text}" />
            <Setter Property="Background" Value="{StaticResource Db.Card}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16"
                                BorderBrush="{StaticResource Db.Border}" BorderThickness="1"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Db.Sunken}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Db.Button.Link" TargetType="Button">
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="#5C5C5C" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                   Foreground="{TemplateBinding Foreground}"
                                   FontSize="{TemplateBinding FontSize}" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Db.Dark}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Tabs del bloque de movimientos: segmentado dentro de una píldora gris -->
        <Style x:Key="Db.SegTab" TargetType="RadioButton">
            <Setter Property="GroupName" Value="Movimientos" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{StaticResource Db.TextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Bd" Background="Transparent" CornerRadius="16" Padding="15,7">
                            <TextBlock x:Name="Tx" Text="{TemplateBinding Content}"
                                       Foreground="{TemplateBinding Foreground}"
                                       FontSize="{TemplateBinding FontSize}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Db.Card}" />
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Db.Text}" />
                                <Setter TargetName="Tx" Property="FontWeight" Value="Medium" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Tx" Property="Foreground" Value="{StaticResource Db.Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- ================= Chips de estado ================= -->
        <Style x:Key="Db.Chip" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource Db.Hover}" />
            <Setter Property="CornerRadius" Value="11" />
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="HorizontalAlignment" Value="Left" />
        </Style>
        <Style x:Key="Db.ChipText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="Medium" />
            <Setter Property="Foreground" Value="#5C5C5C" />
        </Style>
        <!-- Chip de atención: relleno negro, texto blanco -->
        <Style x:Key="Db.Chip.Strong" TargetType="Border" BasedOn="{StaticResource Db.Chip}">
            <Setter Property="Background" Value="{StaticResource Db.Dark}" />
        </Style>
        <Style x:Key="Db.ChipText.Strong" TargetType="TextBlock" BasedOn="{StaticResource Db.ChipText}">
            <Setter Property="Foreground" Value="{StaticResource Db.OnDark}" />
        </Style>

        <!-- Avatar circular con iniciales -->
        <Style x:Key="Db.Avatar" TargetType="Border">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="CornerRadius" Value="16" />
            <Setter Property="Background" Value="{StaticResource Db.Track}" />
        </Style>
        <Style x:Key="Db.AvatarText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#5C5C5C" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- Encabezado de columna de la lista de movimientos -->
        <Style x:Key="Db.ColHeader" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="#B0B0B0" />
        </Style>

    </Window.Resources>

    <!-- ===================================================================
         Layout: sidebar fija + zona principal con scroll
         =================================================================== -->
    <Grid Background="{StaticResource Db.Bg}" ClipToBounds="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Blobs del fondo (el mockup usa gradientes radiales difusos) -->
        <Ellipse Grid.ColumnSpan="2" Width="820" Height="820" Margin="0,-320,180,0"
                 HorizontalAlignment="Right" VerticalAlignment="Top" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.55" RadiusY="0.55">
                    <GradientStop Color="#FFFFFFFF" Offset="0" />
                    <GradientStop Color="#00FFFFFF" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>
        <Ellipse Grid.ColumnSpan="2" Width="700" Height="700" Margin="0,0,-160,-300"
                 HorizontalAlignment="Right" VerticalAlignment="Bottom" IsHitTestVisible="False">
            <Ellipse.Fill>
                <RadialGradientBrush RadiusX="0.6" RadiusY="0.6">
                    <GradientStop Color="#FFD2D2D2" Offset="0" />
                    <GradientStop Color="#00D2D2D2" Offset="1" />
                </RadialGradientBrush>
            </Ellipse.Fill>
        </Ellipse>

        <!-- ==================== Sidebar ==================== -->
        <Border Grid.Column="0" Width="248" Margin="16,16,0,16"
                Background="{StaticResource Db.Card}" CornerRadius="24" Padding="18,26">
            <Border.Effect>
                <DropShadowEffect Color="#000000" Opacity="0.06" BlurRadius="40" ShadowDepth="10" Direction="270" />
            </Border.Effect>

            <DockPanel>

                <!-- Marca -->
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,0,8,26">
                    <Border Width="32" Height="32" CornerRadius="10" Background="{StaticResource Db.Dark}">
                        <TextBlock Text="S" FontSize="14" FontWeight="Bold"
                                   Foreground="{StaticResource Db.OnDark}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="StayEasy" Margin="10,0,0,0" FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource Db.Text}" VerticalAlignment="Center" />
                </StackPanel>

                <!-- Usuario del turno (abajo) -->
                <Border DockPanel.Dock="Bottom" Margin="0,18,0,0" Padding="0,16,0,0"
                        BorderBrush="{StaticResource Db.Track}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border Grid.Column="0" Width="34" Height="34" CornerRadius="17" Background="#E4E4E4">
                            <TextBlock x:Name="Lbl_iniciales" FontSize="12" FontWeight="SemiBold" Foreground="#5C5C5C"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="Lbl_UsuarioNombre" Text="Marina Ríos" FontSize="13" FontWeight="Medium"
                                       Foreground="{StaticResource Db.Text}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="Lbl_UsuarioRol" Text="Recepción" FontSize="11.5"
                                       Foreground="{StaticResource Db.TextFaint}" />
                        </StackPanel>
                        <Button x:Name="Btn_Configuracion" Grid.Column="2" Width="30" Height="30"
                                Style="{StaticResource Db.Button.Round}" ToolTip="Configuración"
                                Background="Transparent" VerticalAlignment="Center">
                            <Path Width="16" Height="16" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{StaticResource Db.TextMuted}" StrokeThickness="1.7"
                                  Data="M15,12 A3,3 0 1 1 9,12 A3,3 0 1 1 15,12 Z M12,3 L13.2,3.6 L13.6,5.6 L15.4,6.4 L17.2,5.6 L19,7.4 L18.2,9.2 L19,11 L21,11.4 L21,13.4 L19,13.8 L18.2,15.6 L19,17.4 L17.2,19.2 L15.4,18.4 L13.6,19.2 L13.2,21 L11.2,21 L10.8,19.2 L9,18.4 L7.2,19.2 L5.4,17.4 L6.2,15.6 L5.4,13.8 L3.4,13.4 L3.4,11.4 L5.4,11 L6.2,9.2 L5.4,7.4 L7.2,5.6 L9,6.4 L10.8,5.6 L11.2,3.6 Z" />
                        </Button>
                    </Grid>
                </Border>

                <!-- Pestañas -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>

                        <!-- ================= Operación ================= -->
                        <TextBlock Text="OPERACIÓN" Style="{StaticResource Db.GroupLabel}" />

                        <RadioButton x:Name="Nav_Inicio" Content="Inicio" IsChecked="True"
                                     Style="{StaticResource Db.NavItem}"
                                     Tag="M4,11.5 L12,4 L20,11.5 M6,10.5 L6,20 L18,20 L18,10.5" />

                        <!-- ================= Alojamiento ================= -->

                        <Grid>
                            <Border Style="{StaticResource Db.NavBadge}" Margin="0,0,10,2" HorizontalAlignment="Right"
                                    IsHitTestVisible="False"/>
                        </Grid>

                        <!-- ================= Comercial ================= -->

                        <!-- ================= Administración ================= -->

                    </StackPanel>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- ================= Zona principal ================= -->
        <DockPanel Grid.Column="1" Margin="16" LastChildFill="True">

            <!-- ================= Encabezado ================= -->
            <Grid DockPanel.Dock="Top" Margin="4,6,2,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="200" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <TextBlock x:Name="Lbl_Titulo" Text="Hola, Marina" Style="{StaticResource Db.PageTitle}" />
                    <TextBlock x:Name="Lbl_Subtitulo"
                               Text="Miércoles 3 de septiembre · 25 movimientos previstos para hoy"
                               Style="{StaticResource Db.PageSubtitle}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">

                    <!-- Búsqueda global -->

                    <Button x:Name="Btn_Notificaciones" Style="{StaticResource Db.Button.Round}" Margin="8,0,0,0"
                            ToolTip="Notificaciones">
                        
                        <Grid Width="42" Height="42">
                            <Path Width="17" Height="17" Stretch="Uniform" Fill="Transparent"
                                  Stroke="{StaticResource Db.Dark}" StrokeThickness="1.7"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                  Data="M18,8 A6,6 0 1 0 6,8 C6,15 3,16 3,16 L21,16 C21,16 18,15 18,8 M10.3,21 A2,2 0 0 0 13.7,21" />
                            <Ellipse x:Name="Dot_Notificaciones" Width="7" Height="7" Fill="{StaticResource Db.Dark}"
                                     Stroke="{StaticResource Db.Card}" StrokeThickness="2"
                                     HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,9,10,0" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- ================= Contenido de la pestaña =================
                 Host_Contenido es el punto de intercambio: el code-behind
                 reemplaza su Content por la vista de cada pestaña. Acá viene
                 cargado con la pantalla de inicio. -->
            <ContentControl x:Name="Host_Contenido">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                              Padding="0,0,4,0">
                    <StackPanel x:Name="Pnl_Inicio">

                        <!-- ============ Fila 1 ============ -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.25*" MinWidth="300" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="280" />
                            </Grid.ColumnDefinitions>

                            <!-- ================= Estado del hotel (tarjeta oscura) ================= -->

                            <!-- ================= Ocupación semanal ================= -->

                            <!-- ================= Ingresos del mes ================= -->
                        </Grid>

                        <!-- ============ Fila 2 ============ -->
                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.55*" MinWidth="420" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" MinWidth="300" />
                            </Grid.ColumnDefinitions>

                            <!-- ================= Movimientos de hoy ================= -->
                            <Border Grid.Column="0" Background="{StaticResource Db.Card}" CornerRadius="24"
                                    Padding="0,24,0,8" VerticalAlignment="Center" Height="704">
                                <StackPanel>

                                    <Grid Margin="26,0,26,18">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" MinWidth="180" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource Db.CardTitle}" ><Run Language="es-ar" Text="Habitaciones"/></TextBlock>
                                            <TextBlock x:Name="Lbl_MovimientosResumen" Text="14 llegadas · 11 salidas"
                                                       Style="{StaticResource Db.CardCaption}" />
                                        </StackPanel>
                                        <!-- Segmentado Llegadas / Salidas / En casa -->
                                        <Border Grid.Column="1" Background="{StaticResource Db.Sunken}"
                                                CornerRadius="19" Padding="3" VerticalAlignment="Center">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="Tab_Llegadas" Content="Llegadas" IsChecked="True"
                                                             Style="{StaticResource Db.SegTab}" />
                                                <RadioButton x:Name="Tab_Salidas" Content="Salidas"
                                                             Style="{StaticResource Db.SegTab}" />
                                                <RadioButton x:Name="Tab_EnCasa" Content="En casa"
                                                             Style="{StaticResource Db.SegTab}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Encabezado de columnas -->
                                    <Border Padding="26,0,26,10" BorderBrush="{StaticResource Db.Hairline}"
                                            BorderThickness="0,0,0,1">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1.6*" />
                                                <ColumnDefinition Width="0.8*" />
                                                <ColumnDefinition Width="1*" />
                                                <ColumnDefinition Width="0.9*" />
                                                <ColumnDefinition Width="Auto" MinWidth="120" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" Text="HUÉSPED" Style="{StaticResource Db.ColHeader}" />
                                            <TextBlock Grid.Column="1" Text="HAB." Style="{StaticResource Db.ColHeader}" />
                                            <TextBlock Grid.Column="2" Text="ESTADÍA" Style="{StaticResource Db.ColHeader}" />
                                            <TextBlock Grid.Column="3" Text="ESTADO" Style="{StaticResource Db.ColHeader}" />
                                        </Grid>
                                    </Border>

                                    <!-- Filas.
                                         Items_Movimientos espera una colección con
                                         Iniciales, Huesped, Reserva, Habitacion, Estadia,
                                         Estado, Accion, EsAccionPrimaria, EsEstadoFuerte.
                                         El segmentado de arriba cambia el ItemsSource. -->
                                    <ItemsControl x:Name="Items_Movimientos">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border Padding="26,13" BorderBrush="{StaticResource Db.RowLine}"
                                                        BorderThickness="0,0,0,1" Background="Transparent">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="1.6*" />
                                                            <ColumnDefinition Width="0.8*" />
                                                            <ColumnDefinition Width="1*" />
                                                            <ColumnDefinition Width="0.9*" />
                                                            <ColumnDefinition Width="Auto" MinWidth="120" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Huésped -->
                                                        <Grid Grid.Column="0">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Style="{StaticResource Db.Avatar}">
                                                                <TextBlock Text="{Binding Iniciales}"
                                                                           Style="{StaticResource Db.AvatarText}" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="11,0,8,0"
                                                                        VerticalAlignment="Center">
                                                                <TextBlock Text="{Binding Huesped}" FontSize="13.5"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource Db.Text}"
                                                                           TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Reserva}" FontSize="11.5"
                                                                           Foreground="{StaticResource Db.TextFaint}" />
                                                            </StackPanel>
                                                        </Grid>

                                                        <TextBlock Grid.Column="1" Text="{Binding Habitacion}"
                                                                   FontSize="13.5" FontWeight="Medium"
                                                                   Foreground="{StaticResource Db.Text}"
                                                                   VerticalAlignment="Center" />

                                                        <TextBlock Grid.Column="2" Text="{Binding Estadia}"
                                                                   FontSize="12.5" Foreground="#5C5C5C"
                                                                   VerticalAlignment="Center" />

                                                        <!-- Chip de estado. El estilo fuerte (negro) se aplica
                                                             desde el code-behind según EsEstadoFuerte. -->
                                                        <Border Grid.Column="3" Style="{StaticResource Db.Chip}"
                                                                VerticalAlignment="Center">
                                                            <TextBlock Text="{Binding Estado}"
                                                                       Style="{StaticResource Db.ChipText}" />
                                                        </Border>

                                                        <Button Grid.Column="4" Content="{Binding Accion}"
                                                                Style="{StaticResource Db.Button.RowPrimary}"
                                                                HorizontalAlignment="Right" VerticalAlignment="Center" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>

                                    <Button x:Name="Btn_VerMovimientos" Content="Ver todos los movimientos"
                                            Style="{StaticResource Db.Button.Link}"
                                            HorizontalAlignment="Center" Margin="0,16,0,12" />
                                </StackPanel>
                            </Border>

                            <!-- ================= Columna derecha ================= -->
                            <StackPanel Grid.Column="2">

                                <!-- Limpieza -->
                                <Border Style="{StaticResource Db.Card.Light}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel Grid.Column="0">
                                                <TextBlock Text="Limpieza" Style="{StaticResource Db.CardTitle}" />
                                                <TextBlock x:Name="Lbl_LimpiezaResumen" Text="18 de 24 tareas cerradas"
                                                           Style="{StaticResource Db.CardCaption}" />
                                            </StackPanel>
                                            <TextBlock Grid.Column="1" x:Name="Lbl_LimpiezaPct" Text="75%" FontSize="20"
                                                       FontWeight="SemiBold" Foreground="{StaticResource Db.Text}"
                                                       VerticalAlignment="Center" />
                                        </Grid>

                                        <Border Height="6" CornerRadius="3" Background="{StaticResource Db.Track}"
                                                Margin="0,16,0,0">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="75*" />
                                                    <ColumnDefinition Width="25*" />
                                                </Grid.ColumnDefinitions>
                                                <Border x:Name="Bar_Limpieza" Grid.Column="0" CornerRadius="3"
                                                        Background="{StaticResource Db.Dark}" />
                                            </Grid>
                                        </Border>

                                        <!-- Desglose por estado -->
                                        <StackPanel Margin="0,16,0,0">
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9"
                                                         Fill="{StaticResource Db.Dark}" Stroke="#E4E4E4"
                                                         StrokeThickness="1" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="Listas para vender" Margin="10,0,0,0"
                                                           FontSize="13" Foreground="{StaticResource Db.TextBody}" />
                                                <TextBlock Grid.Column="2" x:Name="Lbl_LimpiezaListas" Text="12"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource Db.Text}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="{StaticResource Db.Mid}"
                                                         Stroke="#E4E4E4" StrokeThickness="1" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="En proceso" Margin="10,0,0,0"
                                                           FontSize="13" Foreground="{StaticResource Db.TextBody}" />
                                                <TextBlock Grid.Column="2" x:Name="Lbl_LimpiezaProceso" Text="6"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource Db.Text}" />
                                            </Grid>
                                            <Grid Margin="0,0,0,10">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="#D0D0D0"
                                                         Stroke="#E4E4E4" StrokeThickness="1" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="Pendientes de revisión" Margin="10,0,0,0"
                                                           FontSize="13" Foreground="{StaticResource Db.TextBody}" />
                                                <TextBlock Grid.Column="2" x:Name="Lbl_LimpiezaRevision" Text="4"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource Db.Text}" />
                                            </Grid>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <Ellipse Grid.Column="0" Width="9" Height="9" Fill="#F0F0F0"
                                                         Stroke="#E4E4E4" StrokeThickness="1" VerticalAlignment="Center" />
                                                <TextBlock Grid.Column="1" Text="Bloqueadas" Margin="10,0,0,0"
                                                           FontSize="13" Foreground="{StaticResource Db.TextBody}" />
                                                <TextBlock Grid.Column="2" x:Name="Lbl_LimpiezaBloqueadas" Text="2"
                                                           FontSize="13" FontWeight="Medium"
                                                           Foreground="{StaticResource Db.Text}" />
                                            </Grid>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <!-- Requiere atención -->
                                <Border Style="{StaticResource Db.Card.Light}" Margin="0,16,0,0" Height="463">
                                    <StackPanel>
                                        <TextBlock Text="Requiere atención" Style="{StaticResource Db.CardTitle}"
                                                   Margin="0,0,0,14" />

                                        <!-- Items_Alertas espera Titulo y Detalle -->
                                        <ItemsControl x:Name="Items_Alertas">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Border Background="#F7F7F7" CornerRadius="14" Padding="14,12"
                                                            Margin="0,0,0,10">
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border Grid.Column="0" Width="26" Height="26"
                                                                    CornerRadius="8"
                                                                    Background="{StaticResource Db.Dark}"
                                                                    VerticalAlignment="Top">
                                                                <TextBlock Text="!" FontSize="12" FontWeight="SemiBold"
                                                                           Foreground="{StaticResource Db.OnDark}"
                                                                           HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" Margin="11,0,0,0">
                                                                <TextBlock Text="{Binding Titulo}" FontSize="13"
                                                                           FontWeight="Medium"
                                                                           Foreground="{StaticResource Db.Text}"
                                                                           TextWrapping="Wrap" />
                                                                <TextBlock Text="{Binding Detalle}" FontSize="11.5"
                                                                           Foreground="{StaticResource Db.TextMuted}"
                                                                           Margin="0,2,0,0" TextWrapping="Wrap" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </Border>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>

                        <!-- ============ Barra de estado ============ -->
                        <Grid Margin="6,10,6,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Orientation="Horizontal">
                                <Ellipse Width="7" Height="7" Fill="{StaticResource Db.Dark}" VerticalAlignment="Center" />
                                <TextBlock x:Name="Lbl_Conexion" Text="Conectado · Sucursal Centro" Margin="7,0,0,0"
                                           FontSize="11.5" Foreground="#9A9A9A" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="Lbl_Sync" Text="Última sincronización 09:41"
                                       Margin="18,0,0,0" FontSize="11.5" Foreground="#9A9A9A" />
                            <TextBlock Grid.Column="2" x:Name="Lbl_Turno" Text="Turno mañana · Marina Ríos"
                                       HorizontalAlignment="Right" FontSize="11.5" Foreground="#9A9A9A" />
                        </Grid>

                    </StackPanel>
                </ScrollViewer>
            </ContentControl>
        </DockPanel>
    </Grid>
</Window>
